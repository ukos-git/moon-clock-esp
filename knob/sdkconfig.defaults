# Knob firmware defaults (ESP32-S3R8). Hand-curated like the clock's
# — never idf.py save-defconfig.

CONFIG_IDF_TARGET="esp32s3"

# Family seam (P0): the knob's board shim carries the BOARD choice; this
# is the third board of the clock family. No PCF85063A on this board —
# the time base is the clock component's software path (internal RTC
# timer + SNTP), the P4's posture.
CONFIG_BOARD_KNOB=y
CONFIG_CLOCK_USE_PCF85063A=n

# The S3-side flash is 16 MB quad (esptool-confirmed 2026-11-07, schematic
# U3 W25Q128JVPIQ).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Octal PSRAM at 80 MHz: the R8's in-package 8 MB. Not used by the K1
# skeleton yet (LVGL buffers stay internal DMA RAM), declared so PSRAM
# surprises surface at boot instead of at first malloc.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 1 kHz systick: the LVGL task delays 5 ms and the dial poller 2 ms; with
# the 100 Hz default pdMS_TO_TICKS floors to 0 ticks and a task spins the
# core (the clock's CONFIG_FREERTOS_HZ=100 lesson, cpu-stats probe).
CONFIG_FREERTOS_HZ=1000

# LVGL 9 (lvgl/lvgl ^9 from the manifest, same family as the clock's 9.6):
# 16-bit panel, clib malloc, dark theme like the clock.
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_THEME_DEFAULT_DARK=y

# The moon producer task's classify/new-moon scans (core moon_event, no
# yields) starve CPU1's idle for ~30 s on a cold boot -- the clock's
# sanctioned posture (sdkconfig.defaults.esp32s3:16): keep CPU0's idle
# check, drop CPU1's (TWDT_PANIC is off anyway; the bake loop itself
# yields every 16 rows).
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# P1 home parity: app_main builds the SHARED home screen (pair cells,
# split-flap digits, seconds arc, alarm row -- plus the whole LVGL build
# under it) on the MAIN task. At the S3's 3584-byte default that
# overflowed on the first boot (device-verified 2026-11-09: "***ERROR***
# A stack overflow in task main" right after the clock/alarm labels
# landed). The S3 never hits this because its home rides the LVGL task
# with the moon pipeline; the P4 raised the same number to 10240 for the
# same reason. 8192 is the knob's margin-tested value (its build is the
# lightest of the three).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# K7d time: pre-P0 this pinned lwIP's SNTP client (CONFIG_LWIP_SNTP=y).
# Since the P0 seam the fix rides components/clock's clock_sntp (one-shot
# lwIP POLL), and IDF 5.5 no longer defines the old symbol — the dead
# line only warned at every build, so it is gone.

# The caption clock spells local time like the clocks' home row (the
# bench boards are Central European; Kconfig default UTC0 stays honest
# for a device with no location).
CONFIG_KNOB_TZ="CET-1CEST,M3.5.0/2,M10.5.0/3"
