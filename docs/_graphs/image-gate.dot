// The host image gate as a black box: one subject (the x86 build of
// the device's own C core), two references, two thresholded MAE
// comparisons, three board textures. The internals are opened in the
// detail sketches:
//   image-gate-references.dot  the dataflow — subject, references,
//                              comparisons
//   image-gate-thresholds.dot  the thresholds, the geometry, SSIM,
//                              the per-target verdict
// The gate runs on a 32-frame set (8 frames per quarter of the phase
// cycle, evenly spaced across the year), rendered at the reference
// geometry with --neutral and dark_zero = 0 — the PHYSICS
// configuration; the display's artistic constants render OUTSIDE this
// path, which is what makes the art pass byte-identical.
// The device half of the same standard is
// docs/verification/device-verify.rst.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph gate {
    rankdir=TB;
    label="The host image gate — one C path, two references";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    subject [label="THE SUBJECT — the C core\ncompiled x86 (host_sim's\nmoon_sim): the exact\ndevice path",
             fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    refs [label="THE TWO REFERENCES — the\nfloat64 Python prototype,\nNASA SVS 5415 ground truth",
          fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    cmps [label="THE TWO COMPARISONS —\nper-frame MAE ≤ 2 porting\nfidelity, ≤ 12 model accuracy",
          fillcolor="#efece4"];
    verdict [label="THE VERDICT — check_gate.py:\nboth pairs inside thresholds,\neach on its board's texture",
             fillcolor="#f4e8e6", color="#b91c1c", fontcolor="#7a1a1a", penwidth=1.6];

    subject -> cmps [color="#2b5fb0", penwidth=1.6];
    refs -> cmps;
    cmps -> verdict [color="#b91c1c", penwidth=1.6];
}
