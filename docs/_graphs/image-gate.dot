digraph gate {
    rankdir=LR;
    label="The host image gate — one C path, two comparisons, three board textures";
    labelloc="t";
    fontname="Helvetica"; fontsize=20;
    node [fontname="Helvetica", fontsize=13, style="rounded,filled",
          shape=box, width=1.7, height=0.5,
          fillcolor="#f2f2ef", color="#525252", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=11, color="#8a8a8a", penwidth=1.3];

    subgraph cluster_subject {
        label="the subject under test";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525252";
        fontsize=14; fontcolor="#3c3c3c";
        c [label="C core\ncomponents/moon/core compiled x86\nhost_sim/moon_sim — the exact device path\nfloat32 · cheap ERFA · relief-gradient cache",
           fillcolor="#dfe6f1", color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70"];
    }

    subgraph cluster_refs {
        label="the two references";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#eef0ee";
        color="#8a8a8a";
        fontsize=14; fontcolor="#6e6e6e";
        py [label="Python prototype\nmoon.astro + moon.renderer\nvalidated model · float64\nsame low-order ephemeris", fillcolor="#eef0ee"];
        nasa [label="NASA SVS 5415\nCGI Moon Kit ground truth\n8,760 frames · final_400x400\ncrops, pixel-aligned", fillcolor="#eef0ee"];
    }

    geom [label="one geometry for all three\n400×400 · r 199.3 · c 199.3/199.5\n--neutral · dark_zero = 0\n(the art path renders OUTSIDE\nthis configuration)",
          fillcolor="#f4f2ec", fontsize=12];

    cmp_py [label="C vs Python\nporting fidelity\nper-frame MAE ≤ 2\ncurrent mean 1.03",
            fillcolor="#f4f2ec", fontsize=12];
    cmp_nasa [label="C vs NASA\nmodel accuracy\nper-frame MAE ≤ 12\ncurrent mean 6.68",
              fillcolor="#f4f2ec", fontsize=12];
    ssim [label="content-window SSIM\nmean 0.908 — reported,\nNOT gated",
          fillcolor="#f2f2ef", color="#8a8a8a", style="rounded,filled,dashed", fontsize=12];

    verdict [label="check_gate.py --target\ns3 │ p4 │ knob\nPASS = both pairs inside\nthresholds, own board texture\nexit 2 = stale sim binary",
             fillcolor="#f6e7dc", color="#b5643a", penwidth=2.2,
             fontcolor="#8a3d18", fontsize=12];

    geom -> c     [style=dashed, color="#8a8a8a"];
    geom -> py    [style=dashed, color="#8a8a8a"];
    geom -> nasa  [style=dashed, color="#8a8a8a"];
    c    -> cmp_py   [color="#2b5fb0", penwidth=1.6];
    py   -> cmp_py   [color="#8a8a8a"];
    c    -> cmp_nasa [color="#2b5fb0", penwidth=1.6];
    nasa -> cmp_nasa [color="#8a8a8a"];
    cmp_py   -> verdict [color="#b5643a", penwidth=2.2, style=bold];
    cmp_nasa -> verdict [color="#b5643a", penwidth=2.2, style=bold];
    ssim -> verdict [style=dashed];
}
