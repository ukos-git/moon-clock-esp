// The clock demo tour (UI_DEMO_MODE) as a black box: demo.c's phase
// machine, its one loop rule, and the one identity that matters —
// every tap is the REAL touch path (a hit-tested second POINTER indev
// beside the BSP's, press 90 + release 60 ms, created after the
// alarm/orientation/idle registrations so it never steals their
// target). The internals are opened in the detail sketches:
//   demo-tour-phases.dot    the ten scripted phases, step by step
//   demo-tour-suppress.dot  what actions.c holds off while it runs
// Facts this box stands on (demo.c / actions.c):
//   ARMED ON SCHEDULE: the boot-animation gate retired 2026-11-13;
//   the tour owns the display until reset.
//   ALARM LAST (8cc3fe4): the 2026-11-08 bench take showed the S3's
//   QSPI completion-loss race (PANEL IO STUCK -> panel watchdog
//   controlled reboot) firing ~29 s into the alarm phase in all four
//   cycles — the wake/dismiss window where the 0x51 brightness ramp,
//   the fade-to-black switch and (then) the spin resume overlapped,
//   the same family as the #96 settings-freeze stall. Placing the
//   phase at the cycle tail keeps roll and sync comparable on every
//   cycle even while that watchdog recovery runs; the race itself was
//   root-caused 2026-11-12 to the wake path's WiFi-init storm and
//   closed with the sync-storm panel-traffic hold (display-lost-dma).
//   The cycle edge is s_cycle++ with the moon index reset.
//   Never tapped on purpose: the wheel's circle-CHECK commit key
//   (it would write spiffs/wifi_credentials.txt and start a connect)
//   and the alarm screen's deactivate-all master (it would really
//   disarm the user's alarms). The tour's edits are bounded to the
//   pomodoro/real-alarm entry screens, which only re-seed their
//   rollers' current values.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph demo_tour {
    rankdir=TB;
    label="The clock demo tour — one scripted cycle, alarm last";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    arm [label="armed on schedule — the\nboot-animation gate retired\n2026-11-13; then the tour\nowns the display until reset",
         fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    phases [label="THE SCRIPTED PHASES —\nmoons → hub → wifi →\nwheel → back → home →\nroll → sync (9 steps)",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    alarm [label="ALARM LAST (8cc3fe4) —\nthe real ring script, the\nreal dismiss, then the\nwake-sync drain",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
    taps [label="EVERY TAP is the REAL\ntouch path — a hit-tested\nPOINTER indev beside the\nBSP's (press 90 + release 60 ms)",
          fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];

    arm -> phases;
    phases -> alarm;
    alarm -> phases [style=dashed, color="#b07d10", fontcolor="#6b4e08",
                     label="s_cycle++ · moon index reset —\nthe stall window stays at the\ncycle's tail"];
    phases -> taps [style=dashed, arrowhead=none];
}
