// The guards as a BLACK-BOX OVERVIEW: the synchronization census at
// the head, three sealed boxes below — the clocks' two keys, the knob's
// single wrapped key, and the key-free band. No take sites, no
// timeouts, no holder lists on this figure: the boxes open into their
// own detail sketches (guards-keys.dot, guards-knob.dot,
// guards-flags.dot on this page). The census line is exactly what
// docs/tools/gen_perf_locks.py re-asserts at figure time (SystemExit
// on any drift): 3 mutex creations, 2 event groups, 1 task-notify
// pair, 4 SEQ_CST fences, ZERO xQueueCreate in app code. FONTS: 12 pt
// everywhere = the page's 16 px body text at 1:1, kept inside the
// content column so object{max-width:100%} never scales it down.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph guards {
    rankdir=LR;
    label="The guards in black boxes — one census, three ownership stories";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.6];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.18,0.11", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    census [label="the app's own synchronization —\n3 mutexes · 2 event groups\n1 task-notify · 4 fences\nZERO queues",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
    clocks [label="THE CLOCKS — two keys\nimage key + panel key\none-way order",
            fillcolor="#e8ddf6", color="#7c3aed", fontcolor="#4c1d95", penwidth=1.6];
    knob [label="THE KNOB — one key\nholder+depth wrapped\nno panel key exists",
          fillcolor="#f6ecd6", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
    nokeys [label="KEY-FREE hands — fences,\nevent groups, one notify",
            fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];

    census -> clocks [color="#7c3aed", penwidth=1.6, fontcolor="#4c1d95",
                      label="2 mutexes"];
    census -> knob [color="#b07d10", penwidth=1.6, fontcolor="#6b4e08",
                    label="1 mutex"];
    census -> nokeys [color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70",
                      label="the rest"];
}
