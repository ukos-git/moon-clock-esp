// The three wake doors and the one shared tail as a black box —
// touch, tilt and the alarm ring all funnel through
// clock_trigger_idle_wake into action_wake_screen; the guards are
// per-door, the tail is shared. Every edge verified in
// components/clock/clock_idle.c, clock_cb.c, main/main.cpp and
// components/ui/actions.c. The internals are in the details:
//   wake-doors-doors.dot  the per-door guards (indev asymmetry,
//                         departure bars, the ring-screen bypass)
//   wake-doors-tail.dot   what action_wake_screen runs — ring stop,
//                         relight, stale-alarm branch, the replay
//                         hold, the radio hand-off
// The tilt signal chain is docs/_graphs/tilt-pipeline.dot; the entry
// ladder is docs/_graphs/sleep-entry.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph wake_doors {
    rankdir=TB;
    label="The wake doors — three guards in, one shared tail out";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    tap [label="the TOUCH door —\nPRESSED only while\nIDLE"];
    tiltd [label="the TILT door — de-\nparture streak, ≤1/s"];
    ringd [label="the ALARM door —\nthe ring screen dis-\nmisses anyway"];
    funnel [label="clock_trigger_idle_\nwake — the ONE\nfunnel",
            fillcolor="#efece4", penwidth=1.6];
    tail [label="action_wake_screen\n— the shared tail",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    hold [label="the replay HOLD —\nre-arm waits for\nthe presentation",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    syncn [label="the radio OFF the\nUI task — the 1.7 s\nfreeze fix"];

    tap -> funnel;
    tiltd -> funnel;
    ringd -> tail [color="#b07d10"];
    funnel -> tail [color="#2b5fb0", penwidth=1.6];
    tail -> hold [style=dashed];
    tail -> syncn [style=dashed];
}
