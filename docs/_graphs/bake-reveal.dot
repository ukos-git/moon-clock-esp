// The bake reveal (UI_MOON_BAKE_REVEAL / KNOB_UI_BAKE_REVEAL, user decision
// 2026-11-14, docs/implementation/bake-reveal): the computation made visible,
// on BOTH board families. Every edge verified in components/ui/moon_ui.c
// (reveal section :1145-1354, hourly legs :1682-1713, replay final leg
// :1902-1972, pause :2767, finish :2977) and knob/components/knob_ui/knob_ui.c
// (bake_publish :344, swap_task :588) + knob_moon.c (bake_frame).
// The clock and the knob share the STATES (black canvas, one completed band
// per displayed state, one atomic lv_refr_now each) but not the buffer
// strategy: the clock reveals into the LIVE s_rgb (every abort must heal from
// the untouched s_frame), the knob reveals into the BACK buffer (the front
// frame survives; a die-unpublished re-hides the disk instead).
// Black-box view here; the full state machines with their citations are
// bake-reveal-clock.dot and bake-reveal-knob.dot.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
digraph bake_reveal {
    rankdir=TB;
    label="The bake reveal — producers arm a watermark, the pacing\ntask turns every completed band into ONE atomic flush;\nthe clock heals from s_frame, the knob re-hides";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.42];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    fade [label="hourly start —\nfade to black,\n5 s producer\nbudget",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    arm [label="producer arms the\nreveal — pub/shown/\nstop under s_rgb_mtx",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    bands [label="ONE atomic band\nlv_refr_now per 50 ms\n— unbaked rows stay\nblack",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    done [label="DONE — publish,\nONE atomic whole-\npanel flush, commit\non show",
          fillcolor="#efece4", color="#3a6b35", fontcolor="#2c4f29", penwidth=1.6];
    heal [label="HEAL on any abort\n— untouched s_frame\nre-converts, whole\nframe back",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    knob [label="the knob shares the\nSTATES, not the buf-\nfer: reveals into\nthe BACK buffer",
          style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
          fontcolor="#3f3f3f"];

    fade -> arm [color="#b07d10"];
    arm -> bands [color="#2b5fb0", penwidth=1.6, label="watermark\nadvances"];
    bands -> done [color="#3a6b35", fontcolor="#2c4f29", label="pub == rows"];
    arm -> heal [style=dashed, color="#b07d10", label="abort"];
    heal -> done [style=dashed];
    bands -> knob [style=dashed, arrowhead=none];
}
