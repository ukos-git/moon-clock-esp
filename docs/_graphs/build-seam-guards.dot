// The configure-time guards, opened (verified before drawing). There is
// ONE guard block — the root CMakeLists' — run by all three boards; the
// knob no longer carries a replicated copy:
//   The asset guards (:138-204): MOON_ALBEDO_W must be an EVEN equirect
//   width; the manifest's alb_w must EQUAL the Kconfig width; the
//   combined blob must fit the moon_assets row of 'the partition CSV the
//   build actually uses' — PARTITION_TABLE_CUSTOM_FILENAME honoured
//   (partitions.csv / partitions_p4.csv / partitions_knob.csv), else
//   partitions.csv — 'they need >= X K' names the KiB. 'All three
//   mismatches have historically surfaced as obscure build/boot
//   failures … so they are FATAL_ERRORs here'. A MISSING blob is a
//   WARNING only — the app boots without the moon.
//   The knob runs the SAME block on the esp32s3 target; the one knob-only
//   difference is that the albedo-width cross-check is SKIPPED for the
//   knob target (it has no MOON_ALBEDO_W Kconfig mirror — the knob code
//   reads the width from the generated header + manifest, so the
//   manifest's own alb_w + the partition fit are its guards). The
//   MOON_ASSET_TARGET selection is s3 default / p4 on the P4 target / knob
//   on CONFIG_BOARD_KNOB (:146-151).
//   Where CONFIG_ symbols come from instead: the sdkconfig.defaults files.
//   sdkconfig.defaults.esp32p4 pins CONFIG_BOARD_P4=y and
//   PARTITION_TABLE_CUSTOM_FILENAME="partitions_p4.csv";
//   sdkconfig.defaults.knob pins CONFIG_BOARD_KNOB=y and
//   PARTITION_TABLE_CUSTOM_FILENAME="partitions_knob.csv" (passed
//   explicitly, -D SDKCONFIG_DEFAULTS). The root's mismatch guard
//   FATAL_ERRORs when IDF_TARGET and the BOARD choice disagree
//   (:115-121), and a second guard (:126-136) FATAL_ERRORs when
//   CONFIG_BOARD_KNOB is set without -D KNOB_BOARD=ON — so a stray knob
//   sdkconfig fails loudly instead of resolving the S3 BSP.
// The sealed version is build-seam.dot; the blob these guards price is
// assets-pipeline.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph build_seam_guards {
    rankdir=TB;
    label="The configure guards — obscure failures die as FATAL_ERRORs";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.35, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    rootg [label="ONE guard block in the\nroot CMakeLists :138-204\n— run by all three boards",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
    kconf [label="CONFIG_ symbols:\nthe sdkconfig.defaults\nfiles (P4 + knob pin\ntheir CSV + board row)",
           fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    g1 [label="MOON_ALBEDO_W\neven (equirect 2:1)"];
    g2 [label="manifest alb_w =\nKconfig width —\nSKIPPED on the knob\n(no Kconfig mirror)"];
    g3 [label="combined_bytes ≤\nthe moon_assets row\nof the CSV in use"];
    miss [label="MISSING blob =\nWARNING only — boots\nwithout the moon"];
    knobg [label="the knob runs the\nSAME block on esp32s3;\nonly the width\ncheck is skipped",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    rootg -> g1;
    g1 -> g2;
    g2 -> g3;
    g3 -> knobg [style=dashed, color="#b07d10"];
    rootg -> miss [style=dashed];
    rootg -> kconf [style=dashed];
}
