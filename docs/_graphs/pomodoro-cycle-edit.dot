// The pomodoro settings machine opened (companion to
// pomodoro-cycle.dot). The alarm-rules screen (screens.c:706): three
// glyphs with colors straight from clock_alarm_rule_types() — bit 0
// interval (stopwatch), bit 1 fixed (alarm clock); the central
// alarm-clock is white while ANY rule is loaded, moon grey when
// everything is off; the scheduler derives the bits from the PARSED
// rules, so the glyphs cannot disagree with the file. The master tap
// (:713, CLICKED): types == 0 -> RETURN ("already off; re-arming goes
// through the two entries"); else clock_alarm_deactivate_all -> "# no
// alarms" whole-file write + reload — the ZERO branch (arm cleared,
// cache dropped, home row --:--) is alarm-lifecycle.dot's disarm
// invariant. The entries are MUTUALLY EXCLUSIVE (:690 comment +
// scheduler): each setter rewrites /spiffs/alarm.txt with ITS single
// rule, so exactly one kind exists and rule_types is at most one bit.
// The stopwatch entry (:790, glyph U+F2F2, lower-left diagonal of the
// central clock) -> SCREEN_ID_SETTINGS_POMODORO; the sub-screen's exit
// returns to the CALLING level (the alarm screen, not the hub). The
// rollers ARE the display (:898): twin shared clock-style rollers,
// hours 0-23 + minutes 0-59, the 96 px bold-numbers font at the home
// clock's glyph centres (hour slot x 153, minute 303, colon 223) under
// the "REPEAT INTERVAL" caption (32 px SSID font); the separate H:MM
// preview label is GONE and tick_screen_settings_pomodoro is EMPTY.
// settings_pomodoro_screen_refresh (:858): get_interval_rule — first
// rule with minute_interval > 0, -1 when none; seed H = N/60, M = N%60
// (LV_ANIM_OFF); no rule -> both rollers read 00 ("a sub-hour rule
// shows hours 0"); a 90-min rule seeds 1:30. ONLY a RELEASED persists
// (:850, both rollers): total = 60*H + M; total < 1 -> REJECTED with
// the log line "interval 0 rejected (keeping the current rule)" — 00:00
// is not a rule, the stored interval survives; keeping the SPIFFS write
// + RTC reschedule off the drag path is the screen's whole design. The
// knob's dial reaches the SAME commit: PRESSED focuses a roller
// (s_dial_roller_focus 0/1, 3 px white circle border — dial_ring; on
// the alarm screen the focus cycles master -> pomodoro -> alarm-clock,
// s_dial_alarm_focus), and the dial COMMIT sends LV_EVENT_RELEASED to
// the focused roller (:4267 — "the roller's RELEASED handler IS the
// commit"), so finger drag and dial detent take the identical path.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph pomodoro_cycle_edit {
    rankdir=TB;
    label="The settings machine — three glyphs, twin rollers,\nand the dial that sends RELEASED";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.4];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    glyphs [label="the three glyphs —\ncolours from\nrule_types(),\nnormalised bits",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    master [label="master tap: types\n== 0 RETURN; else\ndeactivate_all",
            fillcolor="#efece4"];
    exclusive [label="MUTUALLY EXCLUSIVE —\neach setter rewrites\nalarm.txt with its\nsingle rule",
                shape=note, fillcolor="#e8e8e4", color="#525252", fontcolor="#1e3f70"];
    stopwatch [label="stopwatch entry →\nSCREEN_ID_SETTINGS\n_POMODORO",
                fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    rollers [label="twin rollers —\n96 px font, home\nx-centres 153 /\n303, colon 223",
             fillcolor="#efece4"];
    seed [label="seed H = N/60,\nM = N%60;\nno rule → 00/00",
          fillcolor="#efece4"];
    released [label="RELEASED only:\ntotal = 60H+M; < 1\nREJECTED, rule\nsurvives",
              fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    dial [label="the knob dial:\nfocus a roller,\nCOMMIT sends\nLV_EVENT_RELEASED",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];

    glyphs -> master [style=dashed, label="central clock"];
    master -> stopwatch [style=invis];
    glyphs -> stopwatch [color="#2b5fb0", label="the stopwatch"];
    glyphs -> exclusive [style=dashed, arrowhead=none];
    stopwatch -> rollers;
    rollers -> seed [style=dashed, label="screen entry"];
    rollers -> released [color="#2b5fb0", label="lift the finger"];
    dial -> released [style=dashed, color="#b07d10"];
}
