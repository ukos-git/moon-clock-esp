// The bring-up the getting-started page walks in prose, drawn as the one
// journey it is: host once, optional asset branch, the port gate, the
// per-target build+flash, the boot sync's two outcomes, and the
// provisioning chain that ends in the SPIFFS credential file. Every edge
// and quote verified against docs/getting-started.rst (:50-105 the steps,
// :107-148 the asset branch), main/main.cpp (boot sync :494-515,
// "Airplane before the panel ever wakes up" :532-542, action_wake_screen
// :644-649), components/ui/actions.c ("on BOTH outcomes" :62-64,
// CONFIG_CLOCK_NTP_TIMEOUT_MS 10000 :65-67, action_start_wifi_sync :793,
// "the ~8+10 s handshake" :796-797, loadScreen(SCREEN_ID_WIFI) :802,
// wifi_sync_kickoff :817, ui_tick_timer_cb :718, the s_wifi_sync_done
// drop :733-734), components/wifi/wifi.c (file path :22,
// WIFI_CONNECTION_TIMEOUT_MS 8000 :28, "credentials not configured" :299,
// wifi_credentials_write :117, wifi_scan_begin :545),
// components/ui/screens.c (home-tap "deliberate second tap" :108-118,
// hub ring[] GLYPH_WIFI :598, roller entry arm :1624-1631, roller tap ->
// keyboard :1559/:1574-1577, wheel commit :2296-2319),
// CMakeLists.txt (mismatch guard :79-84, even-width :107-108, manifest
// width :130-134, partition fit :156-163, spiffs FLASH_IN_PROJECT :168,
// blob flash-vs-warn :179-185) and knob/CMakeLists.txt (manifest FATAL
// :59-63, blob-missing WARN :99-105). The chip gate carries the honest
// ESP32S3 ambiguity from docs/devices/index.rst:113-122. The flash
// command chain itself is docs/_graphs/build-flash.dot (devices/index),
// the three-projects seam is docs/_graphs/build-seam.dot
// (reference/build-system), the transient screen's anatomy is
// docs/_graphs/wifi-sync.dot (ui/wifi) — cross-refs kept reciprocal there.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph bringup {
    rankdir=LR;
    label="The bring-up in one picture: host once, optional assets behind the configure-time guards, the chip_id gate no port may skip, one build + one flash per board, the boot sync resolving BEFORE the panel — and the provisioning chain that ends where the boot sync began, on the credential file";
    labelloc="t";
    fontname="Helvetica"; fontsize=17;
    node [fontname="Helvetica", fontsize=12, style="rounded,filled",
          shape=box, width=1.9, height=0.5,
          fillcolor="#f2f2ef", color="#525252", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=10, color="#8a8a8a", penwidth=1.3];

    subgraph cluster_host {
        label="the host, once — every idf.py session starts in this shell";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        idf [label="install ESP-IDF v5.5.1 (the version the\nproject is built against): clone, checkout\nv5.5.1, ./install.sh esp32s3 — 'esp32p4 as\nwell, for the 4C board' — then\n'source ~/esp/esp-idf/export.sh' (getting-started :50-62)",
             fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
        clone [label="git clone moon-phase — 'Fresh clones\nbuild from the checked-in\nsdkconfig.defaults (no manual\nsdkconfig anywhere)' (getting-started :79-80): the 3-file\nsplit shared + .esp32s3/.esp32p4, later\nfile wins",
                 fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
    }

    subgraph cluster_assets {
        label="the moon assets — OPTIONAL branch: only on a pipeline or MOON_ALBEDO_W change (getting-started :107-148)";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        pipe [label="cd assets/images/moon &&\n.venv/bin/python -m moon.assets\n--target s3 p4 knob — loads the\n4096x2048 16-bit LROC albedo (16-bit\nvia tifffile; the texture carries the\n180° longitude offset), emits\nout/<t>/moon_assets.bin + manifest +\nthe TRACKED generated header\ncomponents/moon/generated/<t>/",
                fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        guards [label="the root's configure-time FATAL_ERROR\ntrio (CMakeLists :107-108 even equirect\nwidth, :130-134 manifest alb_w equals the\nKconfig width, :156-163 the combined blob\nfits the moon_assets row — 'they need\n>= X K' names the KiB): 'All three\nmismatches have historically surfaced as\nobscure build/boot failures … so they\nare FATAL_ERRORs here' (:88-93). The\nknob replicates the shape minus the\nKconfig-width check and is STRICTER\nabout existence — a missing manifest\nkills the build (:59-63)",
                    fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
        warn [label="a MISSING blob is a WARNING only —\n'(the build succeeds, but the\nmoon_assets partition is not flashed)'\n(:181-185; knob :99-105 same, its comment\nnames the state: 'a hand-deleted .bin\nbeside a live manifest'): the clock boots,\nBLEACH — no moon until the blob lands",
               fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
        gate [label="the image gate proves the pipeline's\noutput against NASA's reference renders\nfor ALL THREE board textures — one\nsimulator build per target: check_gate.py\n--target s3 | p4 | knob (getting-started :144-148)",
              fillcolor="#efece4", color="#8a8a8a", fontsize=10];
    }

    subgraph cluster_port {
        label="the port — never hard-coded: the mapping changes with the USB topology (devices/index)";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        plug [label="plug in ONE board and watch what\nappears: 'the node that appears on\nplug-in (and disappears on unplug)\nis that board's port' — ls /dev/ttyACM*,\ndmesg | tail (getting-started :68-75)",
                fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        chipid [shape=diamond, label="esptool.py --port <port>\nchip_id — 'the single check\nthat catches a stale port\nguess'; run it against the\nport you are ABOUT to flash",
                  fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.8];
        trap [label="ESP32S3 names the AMOLED board AND the\nknob — 'both are ESP32-S3 with 16 MB\nflash, so the chip report alone cannot\ntell them apart'; disambiguate by which\nboard you just plugged in, by the knob's\nplug orientation (the U4WDH side reports\nESP32-U4WDH) and by label. Re-run the\ncheck after any re-plug — the mapping\ndoes not survive one (devices/index:115-122)",
                fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    }

    subgraph cluster_build {
        label="one build, one flash per board — the target decides which BSP, table and blob";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        s3build [label="the S3 AMOLED (default target):\nidf.py build — 'the repo's idf.py\nbuild picks ESP-IDF up from the\nsourced environment' (getting-started :51-52)\n— then idf.py flash -p <port>,\nidf.py monitor -p <port> (115200)",
                  fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        p4build [label="the P4 4C: 'the same flow with the\ntarget and build directory pinned on\nEVERY command' — idf.py -D\nIDF_TARGET=esp32p4 -B build/p4\nbuild / flash, against the port that\nreported ESP32-P4 (getting-started :90-94)",
                  fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        referee [label="the referee between them is a\nconfigure-time FATAL_ERROR: 'a stray\nCONFIG_BOARD_P4=y in an S3 build, or\nvice versa, would resolve two BSPs /\nthe wrong partition table and fail\nobscurely deep in the build' (root\nCMakeLists :76-84)",
                   fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
        flash [label="one idf.py flash carries THREE\nregions: app + the storage SPIFFS\n(spiffs_create_partition_image(storage\n…) FLASH_IN_PROJECT, :168) + the\nmoon_assets blob (esptool_py_flash_to_\npartition(flash \"moon_assets\"), :180).\nCheck the binary against the factory\nrow (2048 K S3 / 9216 K P4)",
                 fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        bfnote [label="the flash command chain in detail is\nbuild-flash.dot (devices/index); the\nthree-projects seam behind the\nbuilds is build-seam.dot (reference/\nbuild-system)",
                fillcolor="#efece4", color="#8a8a8a", fontsize=10];
    }

    subgraph cluster_boot {
        label="first boot — the sync resolves BEFORE the panel exists";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        bootsync [label="wifi_manager_init() reads\n/spiffs/wifi_credentials.txt (main\n:496; no file -> 'WiFi credentials not\nconfigured. Please set valid\ncredentials.' wifi:299) and clock_init\nruns NTP when the radio came up\n(:510-515). 'The boot NTP (clock_init)\nis synchronous and done here; nothing\nneeds the radio until the first\non-demand sync' — then wifi_manager_\ndeinit(): 'Airplane before the panel\never wakes up' (comment :532-541, the\nDTIM beacon theft, task #29)",
                   fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
        ok [label="clock acquired -> action_wake_screen\nlands straight on the home (airplane)\nscreen with the boot bake showing the\nstatic phase; the transient WiFi screen\n'is never shown at boot on the success\npath' (main :644-662)",
            fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        fail [label="no credentials / sync failed ->\naction_start_wifi_sync (actions :793)\nloads the transient WiFi screen (:802,\nmoon + clock + seconds arc + grey\nindicator) and spawns the background\nsync task ('WiFi + NTP sync in\nbackground task…', :71) through the\n'~8+10 s handshake' (:796; 8000 ms\nwifi:28 + 10000 ms NTP actions :66)",
               fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        drop [label="the UI tick picks the sync up and\ndrops to airplane on BOTH outcomes —\n'a failure must not strand the device\non the WiFi screen' (comment :62-64;\nui_tick_timer_cb :718, s_wifi_sync_done\n:733-734). No boot poller ever existed\nagain: the hand-off is one tick pickup",
                fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    }

    subgraph cluster_prov {
        label="provisioning — the chain that ends where the boot sync began: on the credential file";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        tap [label="TAP home — or the transient WiFi\nscreen: the same root handler\n(event_handler_cb_home_tap) opens the\nsettings hub, LV_EVENT_CLICKED &&\n!clock_is_idle() — 'the wake tap\nitself never opens the hub — a\ndeliberate second tap does' (screens\n:108-118)",
               fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        hub [label="the hub ring: the GLYPH_WIFI entry\ncarries SCREEN_ID_SETTINGS_WIFI as its\nuser_data — ring[] :594-604 (:598),\nthe same table the tap ladder BFS-walks",
             fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        scan [label="the settings-WiFi screen arms the\nscan at ENTRY: scan_panel_hold_arm()\nBEFORE wifi_scan_begin() (:1624-1631,\nwifi :545) — the hold is the 968ac4f\ntraffic hold; the roller shows the\ncentred SCANNING / NO APS placeholder\nuntil the results render rows",
                fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        kb [label="tap an AP row: the roller's CLICKED\nhandler loads the round wheel\nkeyboard with the SSID prefilled\n(settings_wifi -> SCREEN_ID_SETTINGS_\nWIFI_PASSWORD, :1574-1577); letters\nfirst, four registers, the house\ncircle-check commits",
            fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        commit [label="the circle-check (LV_EVENT_PRESSED,\n:2313-2319): an empty password is\nREJECTED ('commit: empty password\nignored', :2297-2300); else\nwifi_credentials_write(ssid, pw) lands\nBOTH lines in /spiffs/\nwifi_credentials.txt (wifi :22, :117)\nand action_start_wifi_sync runs the\nhandshake again — connected, the tick\ndrops to the home WITH the moon",
                   fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
        crednote [label="wifi_credentials.txt is gitignored —\n'never commit' it; spiffs/ edits are\nseparate spiffs: commits (CLAUDE.md\nhard invariant). idf.py flash rewrites\nthe partition from spiffs/: a tracked\nexample is all the image carries",
                   fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    }

    idf -> clone;
    clone -> pipe [style=dotted, label="optional — only after\ntouching the pipeline\nor MOON_ALBEDO_W", color="#8a8a8a"];
    clone -> plug [color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    pipe -> guards [style=invis];
    guards -> warn [style=dotted, color="#b07d10", label="the guard's softer twin:\nexist? fatal — present? warned"];
    pipe -> gate [style=dotted, color="#8a8a8a"];
    plug -> chipid [color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    chipid -> trap [style=dotted, color="#b07d10"];
    chipid -> s3build [label="ESP32S3\n(AMOLED — or the knob,\ndisambiguate by hand)",
                        color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    chipid -> p4build [label="ESP32-P4", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    s3build -> referee [style=dotted, color="#b07d10"];
    p4build -> referee [style=dotted, color="#b07d10"];
    s3build -> flash;
    p4build -> flash;
    flash -> bfnote [style=dotted, color="#8a8a8a"];
    flash -> bootsync [color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6,
                       label="monitor at 115200\nwatches this"];
    bootsync -> ok [label="NTP fixed", color="#2b5fb0", fontcolor="#1e3f70"];
    bootsync -> fail [label="no credentials /\nfix failed", color="#b07d10", fontcolor="#6b4e08"];
    fail -> drop;
    ok -> tap [style=invis];
    drop -> tap [color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6,
                 label="the user takes\nthe wheel"];
    tap -> hub -> scan -> kb -> commit;
    commit -> bootsync [style=dashed, color="#2b5fb0", fontcolor="#1e3f70",
                        label="the next boot's sync\nfinds the file", penwidth=1.4];
    commit -> crednote [style=dotted, color="#b07d10"];
    scan -> fail [style=dashed, color="#8a8a8a", label="the commit re-runs\nthe same handshake", penwidth=1.0];
}
