// THE KEY-FREE BAND opened: the hands-offs the app runs without any
// key. s_sntp_event_group (clock_sntp.c:140) sets SNTP_SYNC_BIT :121
// and waits :180 bounded BY CALLER — the clocks' boot fix and wake fix
// both pass CONFIG_CLOCK_NTP_TIMEOUT_MS 10000 (clock.c + actions.c),
// the knob's boot fix 20000 with a 2 s retry (main.c). s_wifi_event_group
// (wifi.c:284) sets CONNECTED :183 / FAIL :171 and waits :329 for 8 s
// (WIFI_CONNECTION_TIMEOUT_MS). The FOUR SEQ_CST fences are the knob's
// row hand-off without any key: the producer's knob_moon.c:135 pairs
// with the swap reader's knob_ui.c:607 ("pair with the producer's row
// fences"), plus :380 and :643 on the swap side. The app's ONE
// task-notify pair is the day-scan doorbell: moon_event_classify_here
// rings xTaskNotifyGive(s_event_task) at moon_ui.c:1146 and
// moon_event_task blocks on ulTaskNotifyTake(pdTRUE, portMAX_DELAY) at
// :1120. xQueueCreate fires ZERO times in app code (the vendored BSP's
// trans queue is cited, never ours: CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH =
// 1, S3 header, used at the BSP's :412 — the 32 KiB SPI DMA
// invariant). The adapter's LVGL mutex is VENDORED — the app takes it
// EXACTLY once, main.cpp:579 bsp_display_lock(-1). The guards in black
// boxes is docs/_graphs/guards.dot (this page); the clocks' keys are
// docs/_graphs/guards-keys.dot; the knob's is docs/_graphs/guards-knob.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph guards_flags {
    rankdir=TB;
    label="Key-free hands — two event groups, four fences, one notify";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.6];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#5c7fb8", penwidth=1.3, fontcolor="#27405e"];

    bootfix [label="boot + wake fixes\n(clock.c, actions.c)"];
    join [label="station join + FAIL\nevent handler"];
    sntp [label="s_sntp_event_group (:140) — set :121\nwait :180, bounded BY CALLER:\n10 s clocks · 20 s knob + 2 s retry",
          fillcolor="#dfe6f1", color="#5c7fb8", fontcolor="#27405e"];
    wifig [label="s_wifi_event_group (wifi.c:284) —\nCONNECTED :183 / FAIL :171, wait :329",
           fillcolor="#dfe6f1", color="#5c7fb8", fontcolor="#27405e"];

    fences [label="4 SEQ_CST fences — the knob's key-free row\nhand-off: producer :135 ↔ swap reader :607\n(+ :380, + :643)",
            style="rounded,filled,dashed"];
    notify [label="the ONE task-notify pair — day-scan doorbell:\nrings :1146, the worker blocks :1120",
            style="rounded,filled,dashed"];
    zeroq [label="xQueueCreate: ZERO in app code — hands ride\nfences, flags and one notify (asserted)",
            style="rounded,filled,dashed"];
    vendored [label="VENDORED, cited never modified — adapter\nmutex once (:579) + BSP one-deep trans queue\n(S3) — the 32 KiB DMA invariant",
              style="rounded,filled,dashed", fillcolor="#e8e8ea"];

    bootfix -> sntp;
    join -> wifig;
    sntp -> join [style=invis];
    wifig -> fences [style=invis];
    fences -> notify [style=invis];
    notify -> zeroq [style=invis];
    zeroq -> vendored [style=invis];
}
