// The shader's dark branch — the black-box pass: the per-pixel inputs,
// the caller's two knobs, the shipped blend path, the hard night test
// the gate (and the retired dusk) still share, and the backlit color
// itself. Every quoted line verified in code and preserved in the
// detail sketches' headers:
//   dark-side-inputs.dot  the five per-pixel inputs + the shared machines
//   dark-side-branch.dot  the shipped smoothstep blend, pixel by pixel
//   dark-side-night.dot   the hard is_night test and its three outcomes
//   dark-side-backlit.dot moon_backlit_night's three-factor product
// The lit-side half of the same pixel is science/lighting.rst
// (lighting_*.svg); the blend's WHY is science/art-pass.rst "The soft
// terminator"; the blood classifier is sky-events.dot; the camera
// basis that decides WHICH pixels exist is geometry-chain.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph dark_side {
    rankdir=TB;
    label="The dark branch — two knobs, the blend, the night test";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.25, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    inputs [label="THE PER-PIXEL\nINPUTS — d, lns, the\nalbedo tap, earthshine"];
    callers [label="THE CALLERS' KNOBS —\ndark_zero, dk_sup:\ngate 0/0 · display 1/0"];
    shipped [label="THE SHIPPED BRANCH —\nboth sides, ONE\nsmoothstep write",
             fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    hard [label="THE HARD NIGHT TEST —\nis_night's three\noutcomes"];
    backlit [label="MOON_BACKLIT_NIGHT —\nA · l · K, K = 0.20,\nLINEAR on purpose"];
    map [label="THE MAP-BUILD\nEROSION — the dusk's\ndk_sup margin, inert",
         style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280"];

    callers -> shipped [color="#2b5fb0", penwidth=1.8];
    callers -> hard;
    inputs -> shipped;
    inputs -> hard;
    shipped -> backlit [style=dotted];
    hard -> backlit [style=dashed];
    callers -> map [style=dashed];
    { rank=sink; backlit; map; }
}
