// The screen-switch fade machine as a black box: loadScreen's
// both-moon decision at the top, the 0x51 fade-out, the while-black
// reparent, and the one branch that lands the frame. The numbers and
// the branch internals are in the detail sketches:
//   screen-switch-fade.dot      the self-guards, the owed fade-in, the
//                               12-step ramp, the storm drop rule
//   screen-switch-branches.dot  the three branches of
//                               moon_ui_screen_switched
// Every edge verified in components/ui/ui.c (loadScreen :51 — the
// both-moon test and ui_clock_attach_to while black) and
// components/ui/moon_ui.c (moon_ui_screen_is_moon :3078,
// moon_ui_fade_out :3019, fade_ramp :2946, moon_ui_screen_switched
// :3119 — the #34 rescue branch, the while-black atomic flush, the
// drain witnesses). The hourly refresh rides the SAME fade_ramp on
// its own pair of legs — that flow is docs/_graphs/bake-reveal.dot;
// the light-sleep dim is the same ramp to a floor
// (docs/_graphs/sleep-entry.dot).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph screen_switch {
    rankdir=TB;
    label="The screen switch — one 0x51 decision, three atomic branches";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.45];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    dec [label="loadScreen — the\nBOTH-MOON test:\nfade, or paint plain",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    fade [label="FADE OUT — the 0x51\ndim to black; the\nfade-in is owed",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    rep [label="REPARENT WHILE\nBLACK — the shared\nclock joins the root"];
    branch [label="THE BRANCH — ONE of\nthree; every frame is\nONE atomic flush",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    rulebox [label="THE 0x51 RULE — it\nwrites NO pixels; its\nwriters queue behind",
             fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    dec -> fade [color="#2b5fb0", penwidth=1.6];
    dec -> rep [style=dashed];
    fade -> rep;
    rep -> branch;
    fade -> rulebox [style=dashed, color="#b07d10"];
}
