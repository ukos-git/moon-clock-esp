// The input chain as a BLACK-BOX OVERVIEW: the clocks' BSP-owned
// single POINTER indev and the knob's two owned tasks both land on
// the SAME hit-test, and the demo injects through a second indev.
// No chip chains, no listener guards, no pin tables on this figure:
// the boxes open into their own sketches on this page
// (input-chain-clocks.dot, input-chain-knob.dot). The wake side is
// docs/_graphs/wake-doors.dot; the pose pipeline behind the 2 s
// press is docs/_graphs/tilt-pipeline.dot; the pins live in the
// wiring sketches (s3/p4/knob-wiring.dot). FONTS: 12 pt everywhere =
// the page's 16 px body text at 1:1, kept inside the content column
// so object{max-width:100%} never scales it down.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph input_chain {
    rankdir=LR;
    label="The input chain in black boxes — two families, one hit-test";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.6];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    clocks [label="THE CLOCKS — the BSP owns\nthe ONE POINTER indev, read\n33 ms, three guarded listeners",
            fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    knob [label="THE KNOB — our own tasks:\npolled touch + pulse-pair dial,\ndial task 20 ms, reentrant lock",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.8];
    demo [label="THE DEMO — a SECOND indev\ninjects real hit-tested taps\nwhile the BSP one stays live",
          style="rounded,filled,dashed", fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    hit [label="lv_timer_handler hit-tests —\nLV_EVENT_CLICKED on the widget,\nall in the LVGL task",
         fillcolor="#efece4", color="#525252"];

    clocks -> hit [color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    knob -> hit [color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    demo -> hit [style=dashed];
}
