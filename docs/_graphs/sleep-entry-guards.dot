// The guard ladder opened (main.cpp:629 dispatches
// action_switch_to_deep_sleep_screen on the LVGL task; verified
// before drawing):
//   The countdown expiry: settings_deep_sleep_countdown_sec
//   (UI_DEEP_SLEEP_COUNTDOWN_SEC, default 60 s, 60..1800 — the
//   settings-deep-sleep picker writes it).
//   Guard 1 — DEMO MODE: refuse the transition AND clock_timer_disable
//   (a dead-black panel mid-recording would ruin the take).
//   Guard 2 — the P4 with a PENDING alarm: the deep state is
//   app-level (no esp_deep_sleep — the crystal keeps running), so
//   the software one-shot could still ring from the dark; the user's
//   power decision keeps the device in the LIGHTER state — return,
//   the light screen stays, the one-shot stays armed. The S3 needs no
//   such guard: its PCF85063A ALM wakes real deep sleep.
//   Deep entry (action_switch_to_deep_sleep_screen): g_asleep =
//   true; WiFi deinit (belt and braces); moon_ui_pause(true);
//   clock_timer_disable (the countdown is spent); loadScreen
//   (DEEP_SLEEP). The deep screen: the clock container carries
//   LV_OBJ_FLAG_HIDDEN (re-applied EVERY entry, so a wake-to-other-
//   screens can't leak visible digits) + moon + sleep glyph;
//   moon_ui_panel_brightness_set(0) — the backlight is OFF
//   (g_backlight_off); the RTC clock update is gated on it.
// The light entry itself: action_switch_to_light_sleep_screen —
// g_asleep = true; wifi_manager_deinit (the radio DOWN — the airplane
// half of the name); UI tick 10 ms -> UI_LIGHT_SLEEP_TICK_MS (100);
// seconds timer PAUSED; idle monitor OFF; moon_ui_pause(true) (moon
// static); THEN clock_timer_enable(settings_deep_sleep_countdown_sec,
// 1 Hz) AT ENTRY — the retired dusk spin's ladder survived as exactly
// this: sleep depth follows the clock, never an animation. The idle
// timeout period: settings_idle_timeout_sec (CLOCK_IDLE_TIMEOUT_SEC,
// default 60 s, 60..1800), any tap/tilt resets it (main.cpp:625
// registers the callback).
// The sealed version is sleep-entry.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph sleep_entry_guards {
    rankdir=TB;
    label="The guard ladder — two reasons to stay in the lighter state";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.45];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    exp [label="the countdown expiry\n— dispatched on the\nLVGL task"];
    demo [label="guard 1 — DEMO MODE:\nrefuse AND disarm;\nno black mid-take",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    p4g [label="guard 2 — P4 with a\nPENDING alarm stays\nin the lighter state",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    stay [label="return to the light\nscreen — the one-shot\nkeeps its schedule"];
    deep [label="deep entry — clock\nhidden, backlight 0,\npause, timer spent",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];

    exp -> demo;
    demo -> p4g;
    demo -> stay [style=dashed, color="#b07d10"];
    p4g -> stay [style=dashed, color="#b07d10"];
    p4g -> deep;
}
