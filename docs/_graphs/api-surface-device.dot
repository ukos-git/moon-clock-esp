// THE DEVICE CALLERS opened: the only two files the shipped devices
// run moon from, and every site they call (blue edges are paths a
// shipped frame took; amber prices the day-scan guard). Verified in
// code before drawing (comment-stripped greps):
//   components/ui/moon_ui.c: geometry six sites (boot bake :1722,
//     hourly producer :1890, replay final :2226, orbit :2332, plus the
//     new-moon scan :2066/:2081); whole bake four (:1750 boot, :1913
//     hourly monolithic under reveal-suppression, :2244/:2248 the replay
//     final's two branches); bake_rows two (hourly bounce :1493, orbit
//     rows :2349, both dark_zero 1); the s_rgb build is ONE leg —
//     moon_fill_rgb_from_frame :1420, internally the plain LUT
//     (moon_gray565 :1430) or the observer gather (moon_rotate :1426 at
//     the q from moon_viewport_rot_deg :1406) — and EIGHT legs run
//     through it: reveal restore :1444, tick backstop heal :1568,
//     convert :1664, hourly publish :1929, replay mid (own hour centre)
//     :2198, replay final (now) :2261, orbit publish :2371, tz
//     re-gather :2999; the one direct convert outside it is the reveal
//     band :1607; set_event four (producers :1742/:1859/:2222 + the
//     replay's set_event(NULL) :2148); classify is NEVER called
//     directly on the LVGL task — the static wrapper
//     moon_event_classify_here :1280 routes cold day scans to
//     core 1 (worker :1270, day tick :3073); seam reads :1726/:1731,
//     eager warmup guard :2863 ("moon assets unavailable").
//   components/knob_moon/knob_moon.c (the knob's whole moon
//     caller): geometry :118, bake_rows row-by-row :128/:145
//     (dark_zero 1), gray565 per row :133/:157, set_event :83,
//     classify :82/:94, any :119, signature :85/:95, seam :55/:56 —
//     its header comment :9-13 calls the bake path the identity
//     moon_rotate "by construction, not hope".
//   Only the clock calls moon_rotate + moon_viewport_rot_deg (the
//     observer-view gather, moon_ui.c:1426/:1406) — the knob keeps its
//     fixed north-up viewport. Neither device file calls
//     moon_gray565_set_warm — warm is the shipped default.
// The sealed version is api-surface.dot (this page); the host tools
// are api-surface-host.dot; the contract census is
// api-surface-headers.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph api_surface_device {
    rankdir=LR;
    label="The device callers opened — every call the shipped frames make";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.3, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#dfe6f1",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#2b5fb0", penwidth=1.3];

    ui [label="moon_ui.c", fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    knob [label="knob_moon.c", fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    guard [label="the classify_here\nguard — never the\nLVGL task", fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    geom [label="geometry — ×6\non the clock"];
    bake [label="whole bake — ×3"];
    bakerows [label="bake_rows — ×2;\nknob: one row\nper lock"];
    lut [label="the tone trio —\nfill leg + band,\n×4 event"];
    vp [label="viewport — q"];
    rot [label="rotate — the\nobserver gather"];
    evclass [label="classify"];
    esp_be [label="the device\nbackend", fillcolor="#f6f1e2", color="#b07d10"];

    ui -> geom; ui -> bake; ui -> bakerows; ui -> lut;
    ui -> vp; ui -> rot;
    ui -> guard [color="#b07d10", penwidth=1.6];
    ui -> esp_be;
    guard -> evclass [color="#b07d10"];
    knob -> geom; knob -> bakerows; knob -> lut;
    knob -> evclass; knob -> esp_be;
}
