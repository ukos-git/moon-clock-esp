// The transient WiFi screen's lifecycle — black-box view: three
// starters, one radio session on its own task, one UI-tick poll does
// the hand-off; the screen is never menu-reachable. Every edge verified
// in components/ui/actions.c (action_start_wifi_sync :793,
// wifi_sync_task_fn :71, the ui-tick hand-off :733, the hourly gate
// :940, the wake tail) and components/ui/screens.c (tick_screen_wifi).
// The three starters: the HOURLY GATE (actions.c ~:940, minute tick —
// minute == 0 && !clock_is_idle() && !demo && !connected &&
// clock_sntp_needs_sync() (CLOCK_NTP_SYNC_INTERVAL_HOURS) && on the
// AIRPLANE screen — "at rest" only: never wake a sleeper for a 30 s
// radio fetch, never yank a settings session); the WAKE PATH (clocks —
// action_wake_screen ends in action_start_wifi_sync when the RTC is
// due; the screen switch to WiFi rides the same task, the sync itself
// never does); and the WHEEL KEYBOARD commit (credentials written,
// then the sync — the knob reaches the screen only through these legs,
// never its background boot SNTP join, boot_arm_task shows nothing).
// Start: :793 — re-entry guard s_wifi_sync_running, idle disabled,
// loadScreen(WIFI), panel dim 100, traffic hold BEFORE the storm, task
// 6144 B prio 10. Details: wifi-sync-start.dot (the starters + guards)
// and wifi-sync-task.dot (the task, airplane-first teardown, hand-off).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph wifi_sync {
    rankdir=TB;
    label="The transient WiFi screen: three starters, one radio session, one poll does the hand-off";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.42];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    starters [label="three starters, no\nmenu entry — hourly\ngate · wake path ·\nkeyboard commit",
              fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    start [label="action_start_wifi\n_sync :793 — re\n-entry guard, idle\noff, hold, 6 KiB",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    shown [label="the WiFi screen —\ngrey glyph until\nconnected",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    task [label="the sync task —\nSNTP bound 10 s,\nairplane inside,\ndetail in -task",
          fillcolor="#efece4"];
    poll [label="the UI-tick poll\n:733 — the ONLY\nthing that leaves\nthe screen",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    home [label="back on airplane —\none atomic flush;\nidle re-arms UN-\nLESS replaying",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];

    starters -> start [color="#2b5fb0", penwidth=1.6];
    start -> shown;
    start -> task [style=dashed, label="spawns"];
    task -> poll [style=dashed, label="done flags,\ntask self-deletes"];
    shown -> poll [style=dashed, label="the 10 ms tick"];
    poll -> home [color="#2b5fb0", penwidth=1.6, label="awake"];
}
