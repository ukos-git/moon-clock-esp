// The crew as a BLACK-BOX OVERVIEW: five sealed boxes — the boot, the
// painter, the core-1 mill, the on-demand one-shots and the knob crew —
// plus the silicon they all interrogate. No internals on this figure:
// every box opens into its own detail sketch on this page
// (task-roster-clocks.dot, task-roster-ondemand.dot,
// task-roster-knob.dot, task-roster-chips.dot). Arrow colours are the
// legend: blue = xTaskCreate* spawn, dashed grey = hand-back (done
// flag, published frame, watermark), amber = periodic chip ask.
// FONTS: 12 pt everywhere = the page's 16 px body text at 1:1, and the
// graph is kept inside the content column so object{max-width:100%}
// never scales it down — smaller text was the old figure's failure.
// Provenance of every edge (comment-stripped greps, same discipline as
// api-surface.dot) lives in the per-sketch comments and the captions.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph task_roster {
    rankdir=LR;
    label="The crew in black boxes — spawns, wakes, and the silicon asks";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.18,0.11", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    boot [label="app_main — radio + clock\nBEFORE the panel",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    painter [label="THE PAINTER · LVGL task\nvia bsp_display_start\np6 · 8 KiB · per-board core",
             fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    mill [label="THE MILL · core-1 producers\nhourly · rebake · replay\nnever concurrent",
          fillcolor="#e8ddf6", color="#7c3aed", fontcolor="#4c1d95", penwidth=1.8];
    shots [label="ON-DEMAND ONE-SHOTS\nwifi_sync · wifi_scan ·\nplay_task — self-delete",
           fillcolor="#d7ecef", color="#0e7490", fontcolor="#155e75"];
    knob [label="THE KNOB CREW\nknob_lvgl · _moon · _swap\n+ encoder, dial, power",
          fillcolor="#f6ecd6", color="#b07d10", fontcolor="#6b4e08"];
    chips [label="THE SILICON\npanels · touch · IMU · RTC\ncard · codec · C6\ndial · ADC",
           shape=box, style="rounded,filled", fillcolor="#eef0ee", color="#5c7fb8", fontcolor="#27405e"];

    boot -> painter [color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70"];
    boot -> mill [color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70",
                  label="moon_ui_init/_start"];
    mill -> painter [style=dashed, constraint=false, label="done flags"];
    painter -> mill [color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70",
                     constraint=false, label="spawns"];
    boot -> shots [color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70",
                   label="on demand"];
    shots -> painter [style=dashed, constraint=false, label="done flag"];
    boot -> knob [color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70"];
    painter -> chips [color="#b07d10", fontcolor="#6b4e08", constraint=false,
                      label="33ms · 1Hz · 1.3s"];
    mill -> chips [color="#b07d10", fontcolor="#6b4e08", constraint=false, label="card at the hour"];
    knob -> chips [color="#b07d10", fontcolor="#6b4e08", constraint=false, label="dial · ADC"];
}
