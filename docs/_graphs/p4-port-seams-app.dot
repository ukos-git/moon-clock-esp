// The app tree, opened (verified before drawing): four components
// that never learn which board they run on, plus the one gate:
//   moon core — board-blind float32; MOON_PX 400/650 per board; the
//   board difference is ONE #if in moon_ui.c.
//   ui — UI_PX(x) = x·panel/466 (ui_px.h), with BAKED font tiers:
//   generated fonts / fonts_p4 (the 96-48-32 / 148-74-50 / 74-37-25
//   tiers, assets pipeline's sibling).
//   clock — CONFIG_CLOCK_USE_PCF85063A=n on the P4 (the RTC chip is
//   S3-side hardware) -> software minute tick + esp_timer countdown.
//   components/wifi — wifi_manager speaks the esp_wifi API; the S3
//   calls the real driver, the P4 calls the shim's remote
//   presentation of the C6 (the chips detail).
//   components/board — THE seam: display init + brightness, the only
//   #if where both boards coexist.
// The sealed box is p4-port-seams.dot; the two chips are
// p4-port-seams-chips.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph p4port_app {
    rankdir=TB;
    label="The app tree — board-blind down to the gate";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    core [label="moon core — board-blind\nfloat32; MOON_PX 400/650;\none #if in moon_ui.c",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    ui [label="ui — UI_PX(x) =\nx·panel/466; baked font\ntiers fonts / fonts_p4",
        fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    clock [label="clock — PCF85063A off:\nsoftware minute tick +\nesp_timer countdown"];
    wifi [label="components/wifi —\nwifi_manager on the\nesp_wifi API (the S3\ngets the real driver)"];
    shim [label="components/board —\nTHE seam: display init +\nbrightness, the only #if",
          fillcolor="#f4e8e6", color="#b91c1c", fontcolor="#7a1a1a", penwidth=1.6];

    core -> ui;
    wifi -> clock [style=invis];
    ui -> shim [label="panel-scaled flush"];
    clock -> shim [style=dashed];
    wifi -> shim [label="the host esp_wifi API"];
}
