// The wall clock's chain of trust as a black box — three bases feed
// one system clock; SNTP (or a manual commit) is the only raiser of
// the trust flag; a never-fixed clock can show the moon on the S3 but
// never a wrong moon on the P4/knob, and never ring an alarm.
// The internals, with every verified line reference, are in the
// detail sketches:
//   time-chain-bases.dot  the three bases + the fallback chain
//   time-chain-trust.dot  the fixers, the trust flag, the gated
//                         consumers, the asymmetry note
// Every edge verified in components/clock/clock.c (:94 init, :113
// pcf85063a_init, :121 expander, :149 sntp init, :155 boot NTP, :257
// epoch, :271 validate, :294 set), components/clock/clock_sntp.c (:35
// flag, :52/:75 15-min snapshot, :88 restore, :96 junk floor,
// :109-122 sync cb, :134-137 TZ, :219/:227 fallback chain, :268
// needs_sync), components/clock/clock_interrupt.c (:165-172 minute
// tick + snapshot, :183 fire gate), components/clock/clock_tz.c
// (:63-117 apply), components/ui/screens.c (:2890-2911 manual commit,
// :3646-3658 unsynced dim), components/ui/moon_ui.c (:2744 start),
// knob/main/main.c (:210-245 wall-arms, :278-292 rule gate), knob/
// components/knob_power/knob_power.c (:56 plausibility floor, :196
// pre-sleep save) and main/main.cpp (:508 settings before clock_init,
// :512 enable_ntp_sync, :532-541 airplane before the panel, :681 the
// poll). The alarm internals around the S3's AF flag and the P4
// one-shot are docs/_graphs/alarm-lifecycle.dot; the sync STARTERS and
// their radio plumbing are docs/_graphs/wifi-sync.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph time_chain {
    rankdir=TB;
    label="The chain of trust — bases, fixers, one door, gated consumers";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.35, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    bases [label="THE THREE BASES — S3\nPCF85063A · P4/knob\nNVS snapshot",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    fixers [label="THE ONLY TRUST\nRAISERS — boot NTP,\nSNTP cb, manual",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    sysclock [label="THE SYSTEM CLOCK —\ntime(), TZ from the\nstore, set BEFORE use",
              fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    door [label="THE MOON'S ONE DOOR —\nclock_get_utc_epoch:\nvalidate or reject",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    cons [label="THE GATED CONSUMERS\n— the bake, the alarm,\nthe dim label",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];

    bases -> sysclock;
    fixers -> sysclock [color="#2b5fb0", penwidth=1.6];
    sysclock -> door;
    door -> cons;
}
