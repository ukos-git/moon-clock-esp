// The clock side of the bake reveal (S3 + P4), in full — components/ui/
// moon_ui.c, Kconfig UI_MOON_BAKE_REVEAL (default y, depends on
// UI_MOON_HOURLY_ENABLE). Every edge verified in components/ui/moon_ui.c
// (reveal section :1145-1354, hourly legs :1682-1713, replay final leg
// :1902-1972, pause :2767, finish :2977).
// The hourly start leg (moon_hourly_service :1682): fade_ramp(panel→0,
// UI_MOON_HOURLY_FADE_MS), s_hourly_faded = true (the #34
// owed-exactly-once rule), 5 s producer budget (HOURLY_BUDGET_MS
// :1687), spawn pinned core 1.
// Producer arms the reveal — moon_reveal_bake(owner) :1230 sets
// pub/shown/clear/stop under s_rgb_mtx. Owners: REVEAL_HOURLY
// (moon_hourly_task's cold-bake leg :1607 — a TF fetch HIT never arms)
// and REVEAL_REPLAY_FINAL (the boot replay's final "now" leg :1929,
// abort_flag = &s_replay_abort — the sleep hand-off's own).
// Core-1 strip loop :1278 — moon_bake_rows into the s_hourly_gray
// bounce, one MOON_REVEAL_ROWS chunk (S3 10 rows → 40 states / P4 13 →
// 50, #error pins divisibility), watermark s_reveal_pub = y1 UNDER
// s_rgb_mtx (the orbit rule), vTaskDelay(1) per chunk; then ONE
// bounded catch-up wait (2500 ms) for the tick to land the tail,
// owner → REVEAL_NONE :1313. NEVER touches the panel, NEVER s_frame.
// The tick's reveal leg (moon_bake_reveal_service :1279, from
// moon_tick_cb :2363, MOON_TICK_MS = 50) is PARKED while
// !s_moon_screen || panel_hold_live() || clock_is_idle() ||
// s_fade_pending || s_orbit_sweeping :1288. s_fade_busy is DELIBERATELY
// not a gate — during the hourly the reveal leg IS the 0x51 writer
// that pays the owed fade-in. The watermark keeps advancing while
// parked.
// State 1 — the BLACK CANVAS :1304: memset s_rgb over the square, full
// invalidate, ONE atomic whole-panel lv_refr_now under s_rgb_mtx;
// s_reveal_dirty = true (s_rgb now diverges from s_frame: half of this
// is not a resting state, any abort must heal).
// State 2 — ONE band per 50 ms tick :1314: rows [shown, pub)
// gray→RGB565 through moon_gray565 into s_rgb,
// lv_obj_invalidate_area of exactly that band on every moon image, ONE
// lv_refr_now under s_rgb_mtx + drain witness "bake reveal". A band is
// ≤ one strip's payload (S3 400·20·2 = 16 000 B < the 23 300 B cap);
// bursty producer → larger catch-up bands. First completed strip pays
// the OWED fade-in :1347 — fade_ramp(0→100, UI_MOON_HOURLY_FADE_MS) +
// s_fade_busy = false, once; the dark window is the fade, not fade +
// bake.
// The DONE legs — hourly: publish (memcpy s_frame + LUT into s_rgb,
// guarded) :1622, tick's done leg moon_hourly_finish(1) :2978 shows it
// as ONE atomic whole-panel flush + clears s_reveal_dirty +
// commit-on-show; visually a no-op over a completed reveal (contract +
// witness kept). Replay final: publish :1944 + s_replay_show — the
// tick shows atomically; dirty STAYS set, so the backstop heal below is
// the final re-convergence (its witness line means normal completion,
// not an abort).
// HEAL — moon_reveal_restore :1209: re-convert the UNTOUCHED s_frame →
// s_rgb (a COMPLETE frame, never half a moon) + ONE atomic whole-panel
// flush, LVGL-task callers only, witness "bake reveal restore".
// Callers: moon_hourly_finish(0) (failed / 5 s budget blown / sleep
// hand-off via moon_ui_pause — heals BEFORE the ramp back, brightness
// never climbs over a half-moon, :2993); moon_ui_pause's replay branch
// (:2797: abort + stop + heal BEFORE the tick pauses — the sleep
// screens must not inherit the canvas); and the tick's backstop :1292
// (owner NONE, dirty set: producer died with strips up — healed on the
// way back).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph bake_reveal_clock {
    rankdir=TB;
    label="The clock side — moon_ui.c :1145-1354; the reveal never touches s_frame";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.4];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    hourly [label="hourly start :1682\n— fade to black,\n5 s budget, spawn\npinned core 1",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    arm [label="moon_reveal_bake\n:1230 — HOURLY\n:1607 or REPLAY\nFINAL :1929",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    strip [label="strip loop :1278 —\nMOON_REVEAL_ROWS,\nwatermark under\ns_rgb_mtx",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    gate [label="tick leg :1279 —\n5 gates park it;\nwatermark keeps\nadvancing",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    canvas [label="state 1 :1304 —\nBLACK CANVAS,\ndirty = true",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    bands [label="state 2 :1314 —\nband [shown,pub) →\natomic flush +\nwitness",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    fadein [label="first strip pays\nthe OWED fade-in\n:1347 — once",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    done [label="DONE — publish\n:1622/:1944, finish\n(1) :2978 atomic\n+ commit-on-show",
          fillcolor="#efece4", color="#3a6b35", fontcolor="#2c4f29", penwidth=1.6];
    heal [label="HEAL :1209 — un-\ntouched s_frame →\ns_rgb, whole frame\nback",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    hourly -> arm [label="cold-bake leg"];
    arm -> strip [color="#2b5fb0", penwidth=1.6];
    strip -> gate [style=dashed, label="watermark"];
    gate -> canvas [color="#2b5fb0", penwidth=1.6, label="gates open"];
    canvas -> bands [color="#2b5fb0", penwidth=1.6, label="per 50 ms"];
    bands -> fadein [style=dashed, color="#b07d10"];
    bands -> done [color="#3a6b35", fontcolor="#2c4f29", label="pub == rows"];
    strip -> heal [style=dashed, color="#b07d10", label="stop / abort"];
    heal -> done [style=dashed];
}
