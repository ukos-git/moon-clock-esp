// The tilt chain as a black box: ONE accelerometer read path feeding
// TWO consumers on TWO clocks — the 1 Hz activity/wake monitor and
// the 10 Hz 90° orientation pipeline — plus the orbit that is off by
// default. The monitor's settled state gates the orientation anchor's
// re-tracking: the one edge between the two consumers. Every edge
// verified in components/imu/imu_qmi8658.c (burst read, |g| band),
// components/ui/moon_ui.c (monitor cb :2426, timer :2729,
// moon_imu_tick :2303), components/clock/clock_idle.c:92 and
// components/ui/actions.c (screen_orientation_apply :467, ori_apply_v10
// :350, ORI_* defines :197-:210). The internals are in the details:
//   tilt-pipeline-monitor.dot  both EMAs, the departure, the two
//                              bars, the streak, the sink
//   tilt-pipeline-orient.dot   the 100 ms gate, int4 quantization,
//                              the window, quadrant, confirm, apply,
//                              the 2 s press re-sync
// The wake door itself and its shared tail are
// docs/_graphs/wake-doors.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph tilt_pipeline {
    rankdir=TB;
    label="The tilt chain — one read path, two clocks, one edge between";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    sensor [label="THE SHARED READ —\nQMI8658C burst, |g|\nband, ready gate",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    mon [label="THE 1 Hz MONITOR —\nactivity + wake bars\non departure",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    ori [label="THE 10 Hz ORIENT —\nquantize, 1 s mean,\nquadrant, confirm",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    orbit [label="THE ORBIT — asin\n(−gz) re-bake, an\nOFF-BY-DEFAULT leg",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    edge_note [label="THE ONE EDGE — the\nsettled verdict re-\ngates re-anchoring",
               fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    sensor -> mon;
    sensor -> ori;
    sensor -> orbit [style=dashed, color="#b07d10"];
    mon -> edge_note [style=dashed, color="#b07d10"];
    edge_note -> ori [style=dashed, color="#b07d10"];
}
