// The flush path as a black box — the whole journey in five sealed
// boxes. The numbers (25-row strips, 23.3 KiB, 32 KiB DMA cap, 23,300
// B, depth-1 queue, 2 s / 3 s caps, the witness timings, the heal/
// restart split) live in the detail sketches and their headers:
//   flush-path-strip.dot     the strip's journey with every byte count
//   flush-path-witness.dot   the three witnesses and the heal/restart
//                            split
// Every edge verified in components/ui/moon_ui.c (wait cb :445,
// watchdog :596-, drain verify :919-, wrapper comment :601-, strip
// math :124) and the vendored BSP
// components/esp32_s3_touch_amoled_1_75/esp32_s3_touch_amoled_1_75.c
// (:493-:530). The lost-completion root cause in IDF is the prose of
// this page; the hourly fade flow is docs/_graphs/tf-hour-cache.dot's
// territory; who fills which buffer before a strip reaches the
// wrapper is buffers-relay.dot (architecture).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph flush_path {
    rankdir=TB;
    label="The flush path — one rule, one bus lock, three witnesses";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.35, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    rule [label="THE RULE — ONE atomic\nlv_refr_now under\ns_rgb_mtx",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    exc [label="THE TWO EXCEPTIONS —\nthe 0x51 fade, the\nbake reveal",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    lvgl [label="THE LVGL DRAW PATH —\nflush_cb, byte swap,\nthe vtable wrapper"];
    bsp [label="THE BSP + SPI DRIVER —\n25-row strips staged\nin internal RAM",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    wit [label="THE THREE WITNESSES —\n2 s gate · 3 s watchdog\n· drain verify",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    panel [label="QSPI DMA → CO5300\n→ the AMOLED panel",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];

    rule -> lvgl [color="#2b5fb0", penwidth=1.6];
    exc -> lvgl [color="#b07d10"];
    lvgl -> bsp;
    bsp -> panel [color="#2b5fb0", penwidth=1.6];
    lvgl -> wit [style=dashed];
}
