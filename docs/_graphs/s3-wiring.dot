// The S3 board as a black box — one sealed box per bus, the SoC on
// its own. Every pin number lives in the detail sketches, never here:
//   s3-wiring-bus.dot   the three buses with their GPIO numbers and
//                       the four I²C members, ALM line included
//   s3-wiring-wake.dot  the RTC ALM -> expander -> CPU-poll path and
//                       the absence of any wake input
// Facts kept verbatim from the Waveshare datasheet pin map (the table
// on this page is the complete reference, incl. the un-used GPS/EXIO
// lines and the 1-bit SPI SD socket on GPIO 1/2/3/41).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph s3_wiring {
    rankdir=LR;
    label="Waveshare ESP32-S3-Touch-AMOLED-1.75 — the buses";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.26, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    s3 [label="ESP32-S3 — dual\nLX7 240 MHz", fillcolor="#efece4", penwidth=1.6];
    qspi [label="QSPI — CO5300\nAMOLED 466×466\nRGB565 · 0x51 dim", fillcolor="#efece4"];
    i2c [label="I²C — CST9217 ·\nQMI8658C · TCA9554\n· PCF85063A"];
    i2s [label="I²S — ES8311\ncodec, speaker\n+ mic", fillcolor="#efeef2"];
    mem [label="16 MB flash —\nfactory 2 MB ·\nassets 2.5 MB"];
    psram [label="octal PSRAM —\nnot SPI-DMA-\ncapable", fillcolor="#efece4"];
    wake [label="RTC ALM — polled\nat 1.3 s, NEVER\na wake input",
          fillcolor="#f6e7dc", color="#b5643a", fontcolor="#8a3d18",
          style="rounded,filled,dashed"];

    s3 -> qspi;
    s3 -> i2c;
    s3 -> i2s;
    s3 -> mem;
    s3 -> psram;
    i2c -> wake [color="#b5643a", style=dashed];
    { rank=sink; mem; psram; wake; }
}
