// One project, three builds, opened (verified before drawing):
//   The root CMakeLists is the single project: S3 is the default
//   target; the P4 is a sibling TARGET (-D IDF_TARGET=esp32p4 -B
//   build/p4) whose target block EXCLUDE_COMPONENTS the vendored S3
//   BSP + the knob_board component (manifest targets: [esp32s3]) 'out
//   of the P4 build AND of the component manager's local-manifest
//   list' (:15-33), and pins DEPENDENCIES_LOCK dependencies.lock.p4
//   BEFORE project() (:31-32, 'which runs the component manager',
//   :29-30); the tracked root dependencies.lock stays the S3's.
//   The knob is a third BUILD of the same tree on the esp32s3 TARGET
//   (Waveshare ESP32-S3-Knob-Touch-LCD-1.8), selected by
//   -D KNOB_BOARD=ON: own build dir (-B build/knob — INSIDE the
//   repo), own gitignored lock dependencies.lock.knob and live
//   sdkconfig.knob. The knob block (:63-65) EXCLUDE_COMPONENTS the
//   vendored S3 BSP, pins DEPENDENCIES_LOCK dependencies.lock.knob,
//   and promotes KNOB_BOARD into the component manager's early
//   requirements pass via idf_build_set_property — 'a plain -D cache
//   variable does NOT [reach that pass]', so the board/imu/knob_*
//   `if(KNOB_BOARD)` branches resolve in BOTH the early pass and the
//   target pass (:48-62). The S3-clock block (:35-46) EXCLUDE_COMPONENTS
//   knob_board so its knob-only managed deps stay out of the S3 lock.
// The sealed version is build-seam.dot; the passes are
// build-seam-passes.dot, the knob pieces build-seam-shims.dot, the guards
// build-seam-guards.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph build_seam_projects {
    rankdir=TB;
    label="One project, three builds — and three locks";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    rootp [label="the ONE project —\nS3 default target;\nits lock stays S3's",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    p4sib [label="the P4 BUILD —\n-D IDF_TARGET=esp32p4\n-B build/p4, own\nlock dependencies.lock.p4"];
    excl [label="EXCLUDE_COMPONENTS\nthe vendored S3 BSP +\nknob_board (P4);\njust the S3 BSP\n(knob build)"];
    lockpin [label="DEPENDENCIES_LOCK\npinned BEFORE\nproject() :31-32",
             fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    knobp [label="the knob BUILD —\n-D KNOB_BOARD=ON on\nesp32s3, -B build/knob,\ngitignored lock + sdkconfig.knob",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    knb [label="idf_build_set_property\n(KNOB_BOARD ON) :67\n— promoted into the\nEARLY requirements pass",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    mgr [label="the component\nmanager runs inside\nproject() — before\nany CONFIG_ exists",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    rootp -> p4sib;
    p4sib -> excl;
    excl -> lockpin;
    lockpin -> mgr [style=dashed, color="#b07d10"];
    knobp -> knb;
    knb -> mgr [style=dashed, color="#b07d10"];
}
