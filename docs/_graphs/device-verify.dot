// The device verification machine as a black box: one defined flow
// (the boot-to-wake capture, read line by line on the 115200 esp-idf
// monitor), the grammar that maps three classes of line onto the
// acceptance triple, and the four surfaces the standard is read on.
// The internals are opened in the detail sketches:
//   device-verify-capture.dot   the five flow stages with their exact
//                               log lines, and the three classes
//   device-verify-surfaces.dot  the four surfaces and the four
//                               incidents hanging off them
// The acceptance TRIPLE (the page's own rule): endpoint AND rate AND
// zero failure lines. The one-sided verdicts: progress but not
// timing = PERFORMANCE REGRESSION; timing but a WDT = LIFECYCLE BUG.
// The standard of the page: a pipeline is accepted when ALL FOUR
// SURFACES agree — the log says it ran, the timing says it ran at
// budget, the panel says it displayed (no underrun, no seam), the eye
// says it is the right picture; a number without the eye's sign-off
// is a hypothesis, not a verification. The host half proves the MATH
// renders (docs/verification/image-gate.rst); this figure is the
// DEVICE half.
// The flows this machine READS belong to other sketches: the fade
// machine is screen-switch.dot, the dim+arm machine sleep-entry.dot,
// the hourly bake bake-reveal.dot, the wake doors wake-doors.dot, the
// bus lock flush-path.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph device_verify {
    rankdir=TB;
    label="The device verification machine — flow, grammar, surfaces";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    capture [label="THE CAPTURE — boot → idle →\nlight sleep → deep sleep →\nwake, read line by line\n(115200, the esp-idf monitor)",
             fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    grammar [label="THE GRAMMAR — three line\nclasses: PROGRESS, TIMING,\nFAILURE",
             fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    verdict [label="THE TRIPLE — endpoint ∧\nrate ∧ zero failure lines\n→ ACCEPTED",
             fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    surfaces [label="THE FOUR SURFACES — the\nCPU's log, the WDT/bus lock,\nthe panel's scanout, the eye",
              fillcolor="#efece4", color="#3a6b35", fontcolor="#2c4f29", penwidth=1.6];
    rule [label="ALL FOUR SURFACES AGREE —\na number without the eye's\nsign-off is a hypothesis",
          shape=note, fillcolor="#e8e8e4", color="#525252", fontcolor="#1e3f70"];

    capture -> grammar;
    grammar -> verdict;
    surfaces -> verdict [style=dashed];
    verdict -> rule [style=dashed, arrowhead=none];
}
