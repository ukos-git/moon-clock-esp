// The SPIFFS store — black-box view: the 64 K storage partition is
// SPIFFS baked from the source tree's spiffs/ dir on EVERY build, but
// runtime-owned: a full flash clobbers the runtime state (the settings
// screens re-create the files). Three files live on it:
//   wifi_credentials.txt  GITIGNORED — line 1 SSID, line 2 password;
//     the tracked example is what ships (secrets never enter the tree);
//   alarm.txt  tracked default (comments-only "# no alarms" since
//     2026-11-19 — a fresh flash must not arm an unasked-for ring) —
//     five-field cron, one rule per line ("0 7 * * 1-5" = 7:00 Mon–Fri;
//     day_of_month + month are ignored);
//   settings.txt  GITIGNORED — "key = value", # comments skipped, six
//     range-validated keys each falling back to its #ifndef-seeded
//     Kconfig default.
// Readers: wifi.c read_wifi_credentials at boot (first non-comment
// line = SSID, second = password); clock_alarm_scheduler fopen("r")
// arms the rule (PCF85063A ALM on S3, esp_timer one-shot on P4 +
// knob — a zero-rule boot MUST clock_clear_alarm or a stale time fires
// a phantom alarm); settings_store_load at boot (main, before the
// audio/roller seeds — the banner quotes the REAL values); the knob's
// power ladder reads the timeout pair LIVE (dim after
// idle_timeout_sec, deep sleep one countdown later). The writers
// (wheel keyboard commit -> wifi_credentials_write — the ONLY runtime
// writer of credentials; clock_alarm_scheduler_write — full replace
// from the alarm-settings screens; settings_store_save — whole-file
// rewrite whose every commit fires on RELEASED, never on the drag
// path) are drawn in spiffs-store-io.dot; the file formats in
// spiffs-store-files.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph spiffs_store {
    rankdir=LR;
    label="The SPIFFS store: one partition, three files, their boot readers";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    part [label="the 64 K storage\npartition — SPIFFS,\nbaked every build,\nruntime-owned",
          shape=note, fillcolor="#e8e8e4", color="#525252",
          fontcolor="#1e3f70"];
    creds [label="wifi_credentials\n.txt — GITIGNORED",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    alarm [label="alarm.txt —\ntracked default",
           fillcolor="#efece4"];
    set   [label="settings.txt —\nGITIGNORED",
           fillcolor="#efece4"];
    wifi  [label="wifi.c boot\nread",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    sched [label="scheduler boot\nread → arms",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    load  [label="settings_store\n_load at boot",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    power [label="knob power\nladder — live",
           style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
           fontcolor="#3f3f3f"];
    io [label="writers →\nspiffs-store-io\n.dot",
        style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
        fontcolor="#3f3f3f"];

    part -> creds;
    part -> alarm;
    part -> set;
    creds -> wifi  [label="SSID +\npassword", color="#2b5fb0"];
    alarm -> sched [color="#b07d10"];
    set -> load;
    set -> power [style=dashed];
    io -> creds [style=dashed];
}
