// The last mile: the two look-ups between a baked gray square and a
// lit panel — the in-plane rotation gather (host-only since
// 2026-11-13) and the fused gray->RGB565 dictionary (every frame that
// ever reached a panel). Black-box pass: the sealed ownership story
// (teal vs blue is the retirement line). Every quoted line verified in
// code and preserved in the detail sketches' headers:
//   rotate-lut-gather.dot  the trig pair + moon_rotate_range, host-side
//   rotate-lut-dict.dot    g565_build, the tint switches, the live users
// The gray square itself is moon-core-flow.dot and dark-side.dot; the
// panel boundary this figure ends at is display.rst (flush-path.dot);
// api-surface-host.dot draws the rotation's only callers again from
// the surface's side.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph rotate_lut {
    rankdir=TB;
    label="The last mile — two look-ups between bake and panel";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.3, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    trig [label="THE TRIG PAIR — one\nquarter turn stored;\ncos = sine a quarter on"];
    gather [label="THE GATHER —\nmoon_rotate_range;\nhost-only, no device",
            fillcolor="#d7ecef", color="#0e7490", fontcolor="#155e75"];
    tint [label="THE TINT SWITCHES —\nset_warm · set_event;\ndisplay-only",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    dict [label="THE DICTIONARY —\ng565_build, 256\nentries, three builds",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    live [label="THE LIVE CUSTOMERS —\nevery path that ever\nreached a panel",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    boundary [label="THE BYTE-ORDER\nBOUNDARY — LVGL 565;\ndisplay.rst owns it",
              style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280"];

    trig -> gather;
    gather -> dict [label="fused", color="#2b5fb0"];
    tint -> dict [color="#b07d10"];
    live -> dict [color="#2b5fb0", penwidth=1.6];
    dict -> boundary [style=dotted];
}
