// The sky-events chain as a black box: who pays for the day scan, and
// who consumes its answer. The internals are in the detail sketches:
//   sky-events-scan.dot        full_moments, se_argmax, classify, the
//                              knob's yield budget
//   sky-events-consumers.dot   the tint LUT, the eclipse bite, the
//                              minute probe's decision
// Every edge verified in components/moon/core/moon_event.c
// (full_moments :138, se_argmax :101, classify :221, the
// CONFIG_BOARD_KNOB yield budget :21-32) and components/ui/moon_ui.c
// (moon_event_task :1103, spawn :2614, moon_event_classify_here
// :1122, moon_ev_scan_allowed :1097, the minute day-tick probe
// :2707+). The classification RULES (the ±18 h moment test, the
// census-pinned super/micro bounds, the eclipse cone) are
// single-sourced in reference/c-api.rst and only named here.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph sky_events {
    rankdir=TB;
    label="The sky events — a day scan paid on core 1, three consumers";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    here [label="classify_here — the\nONLY gate every call\nwalks through",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    worker [label="THE WORKER — core 1,\n12 KiB SPIRAM stack,\nunder the bake prio"];
    scan [label="THE DAY SCAN — ~600\nevals, cached per day,\nNEVER on LVGL",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    cons [label="THE THREE USES —\ntint LUT · eclipse\nbite · minute probe",
          fillcolor="#efece4", color="#3a6b35", fontcolor="#2c4f29"];

    here -> scan [color="#2b5fb0", penwidth=1.6];
    here -> worker [style=dashed, color="#b07d10"];
    worker -> scan [color="#2b5fb0", penwidth=1.6];
    scan -> cons [color="#3a6b35"];
    here -> cons [style=dashed, color="#3a6b35"];
}
