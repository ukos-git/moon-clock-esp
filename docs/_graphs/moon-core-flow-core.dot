// The portable core opened (companion to moon-core-flow.dot).
// components/moon/core — board-blind, allocation-free, shared VERBATIM
// (device = host_sim = knob). moon_geometry (moon_astro.c + vendored
// ERFA): ephemeris — sun + moon vectors, phase; O(1), < 0.05 ms on the
// host; called once per bake (the full chain is geometry-chain.dot).
// assets: pre-baked blobs in flash — albedo 864x432 S3/knob,
// 2048x1024 P4; DEM 2048x1024, knob 1024x512. moon_relief
// (moon_bake.c): the gradient cache is built ONCE at boot — int8,
// 0.003 rad steps, ~1.3 s on the S3 / 727 ms on the knob — fed by one
// DEM pass, O(N_dem), size-independent. moon_bake_rows (moon_bake.c):
// per-pixel Lambert + relief + art branch, O(N); backlit night, soft
// terminator; publishes ROWS as they finish, each pixel one
// nearest-neighbour albedo tap + one packed gradient load. moon_event.c
// classifies once into a gray->RGB565 tint LUT (blood-moon occlusion
// rides the LUT). moon_render.c / moon_fixp.c: moon_rotate (Q15.15
// gather, quarter table) and moon_gray565 (+ warm flag). The finished
// rows leave through the watermark in moon-core-flow-panel.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph moon_core_flow_core {
    rankdir=TB;
    label="The core, opened — geometry, assets, relief, bake, event, render";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.45];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    epoch  [label="UTC epoch", fillcolor="#efece4"];
    geom   [label="moon_geometry —\nO(1), < 0.05 ms,\nonce per bake",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    asset  [label="assets — albedo\n864×432 · P4\n2048×1024 · DEM",
            fillcolor="#efece4"];
    relief [label="relief cache —\nbuilt ONCE at boot,\n~1.3 s S3",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    bake   [label="moon_bake_rows —\nLambert + relief +\nart; publishes\nROWS as they finish",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    event  [label="moon_event —\nclassify once →\ntint LUT",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    render [label="moon_render —\nrotate Q15.15 +\ngray565 (warm)",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    out [label="→ the panel side\n(panel.dot)",
         style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
         fontcolor="#3f3f3f"];

    epoch -> geom;
    asset -> relief [label="one DEM pass,\nboot"];
    asset -> bake [label="one NN tap\nper pixel"];
    relief -> bake [color="#b07d10"];
    geom -> bake [label="geom_t", color="#2b5fb0"];
    geom -> event;
    bake -> render [label="finished rows", color="#2b5fb0"];
    event -> render [label="tinted gray"];
    bake -> out [style=dashed, color="#b5643a"];
}
