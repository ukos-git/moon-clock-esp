// The thresholds, opened (verified before drawing):
//   The thresholds are asymmetric BY CONSTRUCTION. C-vs-Python,
//   per-frame MAE ≤ 2 (current mean 1.03), is the PORTING-FIDELITY
//   gate (plan: "within ~2 MAE of the Python full model"); C-vs-NASA,
//   per-frame MAE ≤ 12 (current mean 6.68), is the MODEL-ACCURACY
//   gate (the prototype's original MAE_MAX = 12). A frame that fails
//   the first but not the second is a transcription bug; one that
//   fails the second but not the first is the model's own residual
//   (the cheap ephemeris's subsolar-point error, the relief model,
//   the tone LUT fit — or the reference's own processing).
//   All three render on ONE geometry: 400×400, radius 199.3 px,
//   center 199.3/199.5 (the gate's pixel-aligned convention, NOT the
//   device panel's 466/400), with --neutral (the neutral gray→RGB565
//   LUT) and dark_zero = 0 (the earthshine path) — the physics
//   configuration; the display's artistic constants (backlit dark
//   side, soft terminator, warm tint) render OUTSIDE this path, which
//   is what makes the art pass byte-identical to the pre-pass run.
//   The content-window SSIM (mean 0.908) is REPORTED, not gated.
//   The verdict is per board: check_gate.py --target s3 | p4 | knob,
//   each pair compared against its OWN board's texture; PASS = both
//   pairs inside thresholds; exit 2 = a stale sim binary built
//   against the other target's texture.
// The dataflow is image-gate-references.dot; the sealed box is
// image-gate.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph gate_thresholds {
    rankdir=TB;
    label="The thresholds — fidelity, accuracy, and the per-board verdict";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    geom [label="ONE GEOMETRY — 400×400 ·\nr 199.3 · c 199.3/199.5 ·\n--neutral · dark_zero = 0;\nthe art path renders OUTSIDE",
          fillcolor="#efece4"];
    cmp_py [label="C vs Python — fidelity:\nMAE ≤ 2 (mean 1.03)",
            fillcolor="#efece4"];
    cmp_nasa [label="C vs NASA — accuracy:\nMAE ≤ 12 (mean 6.68)",
              fillcolor="#efece4"];
    ssim [label="content-window SSIM —\nmean 0.908: reported,\nNOT gated",
          fillcolor="#f2f2f2", color="#6b7280", fontcolor="#3f3f3f",
          style="rounded,filled,dashed"];
    verdict [label="check_gate.py --target\ns3 / p4 / knob — PASS = both\ninside thresholds on the\nboard's own texture;\nexit 2 = stale sim binary",
             fillcolor="#f4e8e6", color="#b91c1c", fontcolor="#7a1a1a", penwidth=1.6];
    asym [label="asymmetric by construction —\nfails first pair only =\ntranscription bug; fails\nsecond only = model residual",
          fillcolor="#f2f2f2", color="#6b7280", fontcolor="#3f3f3f",
          style="rounded,filled,dashed"];

    geom -> cmp_py [style=dashed];
    geom -> cmp_nasa [style=dashed];
    cmp_nasa -> ssim [style=invis];
    cmp_py -> verdict [color="#b91c1c", penwidth=1.6];
    cmp_nasa -> verdict [color="#b91c1c", penwidth=1.6];
    ssim -> verdict [style=dashed];
    verdict -> asym [style=dashed, arrowhead=none];
}
