// The camera basis, the scalars and the eclipse shadow (companion to
// geometry-chain.dot). All citations components/moon/core/moon_astro.c
// + moon.h + moon_event.[ch] unless noted. Camera — the view from
// Earth: north = unit(Ns − (Ns·Lu)·Lu) with Ns = [0,0,1] (:137-141) —
// celestial north flattened onto the sky plane; the guard comment
// :133-136: projecting against a NON-unit L "leaves a component along
// the line of sight, tilting the disk" — hence Lu, not L. east =
// unit(north × L) (:143); screen right = −east (:147) — the EAST-LEFT
// convention (lunar east waxes on the left); the twin sign knob is
// MOON_POSANGLE_SIGN (1.0) used at :199 — the two things easy to
// backwards, together with the 180° texture offset (MOON_TEX_LON_OFFSET,
// moon.h). The scalars — gate fields, not pixels: body_lonlat
// (:62-78) on S and on E (:126-131): swing the reference arrows by W
// again (:66-67), lon = atan2(v·yb, v·xb) (:71), lat = asin(clamped
// v·P) (:72-77) → subsolar_lon/lat + subearth_lon/lat. posangle
// (:192-203): Np = unit(P − (P·Lu)Lu), then MOON_POSANGLE_SIGN·
// atan2(Np·east, Np·north) mod 360 — nothing drawn depends on it; the
// gate cross-checks it against NASA with tolerance 2.0°
// (GEO_POSANGLE_TOL_DEG). phase (i = Sun–Moon–Earth angle): cos i =
// Su·Eu (:206, clamped), phase_angle_deg = acos (:211), illum =
// (1 + cos i)/2 (:212 — i=0 full, 180 new), distance_km = |mg|·AU_KM
// 149597870.7 (:21, :213) — the ONLY place a distance survives, for
// display. The eclipse shadow axis (:155-190): s = −sun/|sun| (the
// umbra cone's axis points AWAY from the Sun), a = mgm·s with mgm =
// mg·MOON_EV_AU_M (moon_event.h:47, meters — the classifier's
// currency), point* = −mgm + a·s (the axis's closest point to the
// Moon's center, perp to s by construction); all three rotated to the
// body frame → shadow_dir, shadow_off, off_ax — and the classifier
// (:255-281) reads the triple: |shadow_off| is the Moon center's perp
// distance to the umbra axis, off_ax the axial coordinate from Earth;
// against the cone constants (moon_event.h:48-49) this is the
// blood-moon test. The image gate — 32 NASA SVS 5415 frames; measured
// max 0.43° subsolar / 0.51° subearth / 0.44° posangle (moon_astro.c
// header :6-7, moon.h:55-57) against tolerances 0.6 / 0.6 / 2.0°.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph geometry_chain_view {
    rankdir=TB;
    label="The camera basis, the scalars, the eclipse shadow — EAST-LEFT and the sign knobs";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.42];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    north [label="north :137-141 — ce-\nlestial north flat-\ntened on the sky;\nguard: use Lu",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    east [label="east :143, right =\n−east :147 — EAST-\nLEFT; POSANGLE_\nSIGN + 180° offset",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    lonlat [label="body_lonlat :62-78\non S and E → sub-\nsolar + subearth\nlon/lat",
            fillcolor="#efece4"];
    pa [label="posangle :192-203\n— nothing drawn de-\npends on it; gate\ntol 2.0°",
        fillcolor="#efece4"];
    phase [label="phase :206-213 —\ncos i, illum, dis-\ntance_km: the only\ndistance surviving",
            fillcolor="#efece4"];
    shadow [label="shadow axis :155-\n190 — s, a, point*\nrotated → dir, off,\noff_ax",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    classifier [label="the classifier :255-\n281 — the blood-\nmoon test vs the\ncone constants",
                 fillcolor="#efece4"];
    gate [label="the image gate —\n32 NASA frames; max\n0.43/0.51/0.44°",
          fillcolor="#efece4"];

    north -> east [label="× L"];
    north -> pa [style=dashed];
    lonlat -> gate [style=dashed];
    pa -> gate [style=dashed];
    phase -> gate [style=dashed];
    shadow -> classifier [style=dashed, color="#b07d10"];
    east -> lonlat [style=invis];
    lonlat -> pa [style=invis];
    pa -> phase [style=invis];
    phase -> shadow [style=invis];
}
