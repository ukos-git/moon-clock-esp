// The P4 4C as a black box — one sealed box per bus, the SoC on its
// own. Pin numbers live in the detail sketches, never here:
//   p4-wiring-bus.dot   DSI lanes, I2C pins, SDIO stack, I2S pins
//   p4-wiring-wake.dot  the wake story: no RTC IC, no IO expander
//                       (board_io_expander_init() -> NULL), the
//                       esp_timer one-shot, the light-sleep rule
//                       while an alarm is pending
// PSRAM note kept for provenance: 200 MHz; the DPI FIFO wants 103-row
// spin strips (underruns at 206) — the spin retired 2026-11-13, the
// number survives in implementation/display.rst history.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph p4_wiring {
    rankdir=LR;
    label="Waveshare ESP32-P4-WIFI6-Touch-LCD-XC (4C) — the buses";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.26, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    p4 [label="ESP32-P4 — quad\nRISC-V 400 MHz", fillcolor="#efece4", penwidth=1.6];
    dsi [label="MIPI-DSI —\nJD9365 720×720\nIPS RGB888", fillcolor="#efece4"];
    i2c [label="I²C — GT911\ntouch, polled"];
    sdio [label="SDIO — ESP32-C6\nremote Wi-Fi"];
    i2s [label="I²S — ES8311\ncodec, speaker\n+ mic", fillcolor="#efeef2"];
    mem [label="32 MB flash —\nfactory 9 MB"];
    psram [label="PSRAM 200 MHz\n— DPI FIFO"];
    wake [label="no RTC IC · no\nexpander — an\nesp_timer wakes",
          fillcolor="#e4efe7", color="#3a7d5c", fontcolor="#1f5c40",
          style="rounded,filled,dashed"];

    p4 -> dsi;
    p4 -> i2c;
    p4 -> sdio;
    p4 -> i2s;
    p4 -> mem;
    p4 -> psram;
    p4 -> wake [color="#3a7d5c", style=dashed];
    { rank=sink; mem; psram; wake; }
}
