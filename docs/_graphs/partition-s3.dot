// S3 (16 MB flash) partition layout — partitions.csv, verified
// against the tracked CSV before drawing: bootloader + partition
// table (nvs 24 K + phy 4 K), factory app 2048 K (the binding
// constraint of the family), storage SPIFFS 64 K, moon_assets
// 2560 K (864x432 albedo + 2048x1024 DEM = 2,470,400 B combined),
// moon_movie 11648 K — the LAST row, owning the chip's leftover
// (one synodic cycle of q90 gray JPEGs; 355 frames @ 2 h =
// 10,264,284 B today). The table fills the whole 16384 K chip
// including the 64 K prefix. The build-time partition-fit guard
// prices the asset blob against the moon_assets row and the movie
// against the moon_movie row (assets-pipeline-guards.dot).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph partitions_s3 {
    rankdir=TB;
    label="partitions.csv — S3, 16 MB flash";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.38];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3,
          arrowhead=none];

    boot    [label="bootloader + table —\nnvs 24 K + phy 4 K",
             fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    factory [label="factory (app) —\n2048 K (binding)",
             fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    storage [label="storage (SPIFFS) —\n64 K",
             fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    assets  [label="moon_assets — 2560 K\n(864×432 albedo +\n2048×1024 DEM)",
             fillcolor="#efece4"];
    movie   [label="moon_movie — 11648 K (LAST)\n(the chip's leftover:\n355 frames @ 2 h today)",
             fillcolor="#efece4"];

    boot -> factory;
    factory -> storage;
    storage -> assets;
    assets -> movie;
}
