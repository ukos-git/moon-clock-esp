// The round keyboard's hit-test/commit machine — black-box view. One
// invisible press band, a sticky-sector reveal, commit ONLY on release —
// press and zone-crossing never add a character. Every edge verified in
// components/ui/screens.c: the inverse-transform hit-test
// wheel_point_to_slot :1915, the sweep handler
// event_handler_cb_wheel_sweep :2221 (PRESSED sticky reveal, PRESSING
// clamp, RELEASED commit, CANCEL heal), set_hot :2034 / set_revealed
// :2062, the register arc event_handler_cb_wheel_mode :2260 +
// set_mode :2109, the three keys :2311/:2332/:2352, the build
// create_screen_settings_wifi_password :2466 (annuli, angles, the
// bar-built icons :2719/:2756), the knob press partition :2635, the
// demo drive :2375-:2450. The centre long-press ages through LVGL's
// default LV_LONG_PRESSED_TIME 400 ms (uisim holds 600 ms,
// host_sim/uisim/main.c:758).
// The press target: ONE transparent lv_arc, annulus r 140..233 (pad 0,
// arc_width WHEEL_C-140, full-360 bg), ADV_HITTEST + PRESS_LOCK
// (:2508) — without ADV_HITTEST lv_arc falls back to a bounding-box
// test and the LAST-created arc wins (the gotcha that ate a day). The
// sweep machine (:2221) and its sticky sector are wheel-commit-sweep
// .dot; the register arc, the four keys and the shared knob/demo/resync
// notes are wheel-commit-keys.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph wheel_commit {
    rankdir=TB;
    label="The round keyboard — one press band, a sticky reveal,\ncommit ONLY on release";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.42];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    catch [label="the press band —\none transparent\narc r 140..233,\nADV_HITTEST",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    sweep [label="the sweep machine —\nslot → reveal → hot,\nsticky clamp; de-\ntail in -sweep.dot",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    commit [label="RELEASED in-band —\nadd the hot char;\nALWAYS heal, boxes\nhide",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    keys [label="the four other touch-\nables — register arc,\nCOMMIT, DISCARD,\ncentre; see -keys.dot",
          fillcolor="#efece4"];

    catch -> sweep [color="#2b5fb0", penwidth=1.6, label="touch-down"];
    sweep -> commit [color="#2b5fb0", penwidth=1.6, label="finger lifts"];
    commit -> catch [style=dashed, label="heal"];
    keys -> catch [style=dashed, arrowhead=none];
}
