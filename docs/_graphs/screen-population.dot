// The UI population as a BLACK-BOX OVERVIEW: the boot spine, the
// hidden city of 16 roots / 255 objects, and the zero-cost visit. No
// per-screen counts, no object bills, no tick/refresh mechanics on
// this figure: the boxes open into their own sketches on this page
// (screen-population-city.dot, screen-population-visit.dot). This
// sketch deliberately draws NO navigation edge — who-may-visit-whom
// is the mermaid graph above it in docs/ui/index.rst and the tap
// ladder's BFS; the switch's fade internals are
// docs/_graphs/screen-switch.dot; the object-cost in bytes is the
// static footprint on verification/performance.rst. Every number is
// re-derived by docs/tools/gen_perf_assembly.py (SystemExit on
// drift). FONTS: 12 pt everywhere = the page's 16 px body text at
// 1:1, kept inside the content column so object{max-width:100%}
// never scales it down.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph screen_population {
    rankdir=LR;
    label="The population in black boxes — 16 roots, 255 objects, built once";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    uiinit [label="ui_init — all 16\ncreators BEFORE\nthe first load",
            fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    city [label="THE HIDDEN CITY\n16 roots, 255 obj\n(256 on the P4)",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.8];
    visit [label="A VISIT: creates\nnothing; at most\none entry refresh",
           fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    eez [label="the EEZ twin —\nnever shipped",
         style="rounded,filled,dashed", fillcolor="#f2f2f2"];
    knobn [label="knob: no widgets —\nrestyles only",
           style="rounded,filled,dashed", color="#7c3aed", fontcolor="#5b21b6"];

    uiinit -> city [color="#525c78", penwidth=1.6];
    city -> visit [color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    eez -> uiinit [style=dashed, color="#9a9a9a", constraint=false];
    knobn -> city [style=dashed, color="#7c3aed", fontcolor="#5b21b6", constraint=false];
}
