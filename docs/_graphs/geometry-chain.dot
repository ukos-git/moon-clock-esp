// The moon_geometry chain — black-box view: one UTC epoch in, one
// moon_geom_t out. Every node and edge verified in
// components/moon/core/moon_astro.c (:19 TT_OFF_S 69.184, :21 AU_KM,
// :26-38 rot_axis, :40-45 unit3, :48-59 body_ref_basis, :62-78
// body_lonlat, :80 moon_geometry, :82 JD(UT), :83 TT, :87 eraEpv00,
// :90 sun = -eh, :93 eraMoon98, :96-102 S/E/L + unit3, :104 W,
// :108-111 the two rot_axis calls, :117-122 dot-with-the-columns,
// :126-131 the four lon/lat fields, :133-153 the camera basis,
// :155-190 the eclipse shadow block, :192-203 posangle, :206-213
// phase/illum/distance), components/moon/include/moon.h (:29-53 the
// struct incl. the shadow triple, :55-57 the NASA accuracy comment),
// components/moon/generated/<board>/moon_consts.h (the calibrated
// constants + MOON_POSANGLE_SIGN 1.0 + MOON_TEX_LON_OFFSET 180.0),
// components/moon/core/moon_event.c (:255-281 the classifier reads the
// shadow triple) and components/moon/include/moon_event.h (:47-49 the
// cone constants). The gate's tolerance numbers (0.6/0.6/2.0 deg) are
// assets/images/moon/moon/constants.py GEO_*_TOL_DEG.
// Four boxes in sequence: the time to TT (geometry-chain-time.dot
// carries the JD/TT arithmetic + the vendored ERFA ephemeris + the
// three unit directions), the calibrated body frame (the same file,
// and geometry-chain-body.dot for the two-number rotation), the camera
// basis + scalars + eclipse shadow (geometry-chain-view.dot), then the
// struct out. The pipeline AROUND this chain — who calls moon_geometry
// and where the finished frame goes — is docs/_graphs/moon-core-flow.dot
// (implementation/core-c.rst); the shading that consumes the four
// arrows is science/lighting.rst; the sampling resolution of the
// textures these lookups hit is the resolution funnel in
// verification/performance.rst.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph geometry_chain {
    rankdir=TB;
    label="moon_geometry — one UTC epoch in, one moon_geom_t out;\ndetails in -time, -body and -view";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.42];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    epoch [label="one int64 UTC\nepoch — the bake's\nsingle input",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    time [label="instant → TT,\nERFA ephemeris —\ndetail in -time",
          fillcolor="#efece4"];
    body [label="the calibrated bo-\ndy frame — wheel\non an axle, TWO\nnumbers",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    view [label="camera basis, the\nscalars, the eclipse\nshadow — in -view",
          fillcolor="#efece4"];
    out [label="moon_geom_t — the\n4 body arrows + sca-\nlars + shadow triple;\nno heap",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    bake [label="the bake — one\nbody direction → one\nNN albedo tap",
          fillcolor="#efece4"];
    gate [label="the image gate —\n32 NASA frames, tol\n0.6/0.6/2.0°",
          fillcolor="#efece4"];
    classifier [label="the moon_event\nclassifier — the\nblood-moon test",
                fillcolor="#efece4"];

    epoch -> time [color="#2b5fb0", penwidth=1.6];
    time -> body;
    body -> view;
    view -> out [color="#2b5fb0", penwidth=1.6];
    out -> bake [color="#2b5fb0"];
    out -> gate [style=dashed];
    out -> classifier [style=dashed, color="#b07d10"];
}
