// THE PAINTER'S LEGS opened (the 50 ms tick, MOON_TICK_MS :184, armed
// :2668): every quote verified in components/ui/moon_ui.c before
// drawing. The done legs read the producer flags (hourly :1812/:1816 ->
// moon_hourly_finish :3158-68; the tick's replay show :2485-2500, the
// deferred re-bake :2515-19), call moon_invalidate_all (:1279) then ONE
// atomic whole-panel lv_refr_now INSIDE the image key, then the drain
// witness -- 8 call sites, 9 names: "re-bake" :1477, "boot replay final"
// / "boot replay" :2498, "rebake" :2519, "orbit batch" :2551,
// "tz re-gather" :2803, "hourly" :3165, "switch fade-in" :3347, "screen
// switch" :3358; commit-on-show -- s_baked_hour/event set only after the
// flush landed (:3166-67). The compute watermark (moon_bake_progress
// :1403-41) publishes s_compute_pub under the image key per
// MOON_COMPUTE_ROWS strip (13 P4 / 10 S3, :1321-23) -- "the mutex orders
// the watermark against the screens' reads" (:1421) -- and the screens
// read the moon_ui_compute_active/progress seam (:1443-49) as plain flag
// reads driving the seconds arc: no key owed on the read, no flush, and
// the producer "NEVER touches the panel" (:1400-402: the old frame -- or
// the boot dummy disc -- stays up the whole bake; the finished frame
// lands as the done leg's one atomic whole-panel flush). The 0x51
// hardware ramp writes NO pixels (the fade-in leg :3333-58): "the flush
// strips take the panel mutex in the draw_bitmap wrapper (per strip --
// taking it here as well would self-deadlock: the mutex is non-reentrant
// and the wrapper IS the flush's panel path)". The buckets and the keys
// in black boxes are docs/_graphs/buffers-relay.dot (this page); the
// asks with their timeouts are docs/_graphs/guards-keys.dot; the
// staging/witness anatomy is docs/_graphs/flush-path.dot (display.rst).
// FONTS: 12 pt = the page's 16 px body text at 1:1 -- kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph buffers_relay_painter {
    rankdir=TB;
    label="The painter's legs -- the done legs, the key-free compute watermark, and the no-pixels ramp";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    done [label="THE DONE LEGS -- flags -> invalidate_all ->
ONE atomic lv_refr_now under the image key,
drain witness - COMMIT-ON-SHOW (:3166-67)",
          fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    compute [label="THE COMPUTE WATERMARK -- s_compute_pub per
MOON_COMPUTE_ROWS strip (13 P4 / 10 S3); the
screens read it plain -> the seconds arc.
NEVER touches the panel (:1400-402)",
             fillcolor="#d7ecef", color="#0e7490", fontcolor="#155e75"];
    fade [label="THE NO-PIXELS LEG -- the 0x51 ramp writes
NO pixels; the atomic flush lands while the
panel is STILL BLACK (:3333-58)",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    keyrgb [label="the IMAGE key\ns_rgb_mtx",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
    keypanel [label="the PANEL key -- s_panel_mtx: the\ndraw_bitmap wrapper takes it per\nstrip -> staged strips -> DMA -> panel",
              fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];

    done -> compute [style=invis];
    compute -> fade [style=invis];
    fade -> keyrgb [style=invis];
    done -> keyrgb [color="#b07d10", fontcolor="#6b4e08", label="held for\nthe flush"];
    compute -> keyrgb [style=dashed, color="#8a8a8a", fontcolor="#374151",
                       label="no key on the read --\npublish orders it (:1421)"];
    fade -> keypanel [style=dashed, color="#b07d10", fontcolor="#6b4e08",
                      label="0x51 steps"];
    keyrgb -> keypanel [style=invis];
}
