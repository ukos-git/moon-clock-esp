// The knob as a black box — one sealed box per driven thing, the app
// MCU on its own, the two silences (untouched peripherals, the U4
// peer) grey and dashed. Everything with a number lives in the
// detail sketches:
//   knob-wiring-display.dot  the SH8601 QSPI pins + the PMOS backlight
//   knob-wiring-io.dot       CST816S, the EC1 dial, the battery ADC
//   knob-wiring-unused.dot   PDM/SDMMC/audio/USB + the U4WDH peer and
//                            the unused inter-MCU UART
//   knob-wiring-wake.dot     the family's only REAL deep sleep:
//                            EXT0/EXT1/TIMER with the never-early-ring
//                            alarm rule and the B-only detent caveat
// Vendor facts come from the five-page schematic + per-function ESP-
// IDF demos (wiki, 2026-11-07): esp_lcd_sh8601 drives the panel (not
// the third-party "ST77916"); LEDA/LEDK nets prove a BACKLIT LCD.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph knob_wiring {
    rankdir=LR;
    label="Waveshare ESP32-S3-Knob-Touch-LCD-1.8 — the app MCU's side";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.24, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    s3 [label="ESP32-S3R8 —\ndual LX7 240 MHz\n· SNTP-only join", fillcolor="#efece4", penwidth=1.6];
    disp [label="QSPI x4 — SH8601\n360×360 round\nLCD, backlit", fillcolor="#efece4"];
    bl [label="backlight PWM —\nGPIO 47 PMOS", fillcolor="#efece4"];
    i2c [label="I²C — CST816S\ntouch · DRV2605\n(unused)"];
    dial [label="EC1 dial — A 8 ·\nB 7, polled 3 ms"];
    batt [label="battery ADC —\nGPIO 1 · ADC1_CH0"];
    unused [label="PDM · SDMMC ·\nI²S DAC · USB —\nall untouched",
            style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280"];
    u4 [label="U4WDH peer —\nUART unused",
        style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280"];
    wake [label="REAL deep sleep\n— EXT0 · EXT1 ·\nTIMER", fillcolor="#e4efe7",
          color="#3a7d5c", fontcolor="#1f5c40", style="rounded,filled,dashed"];

    s3 -> disp;
    s3 -> bl;
    s3 -> i2c;
    s3 -> dial;
    s3 -> batt;
    s3 -> unused [style=dashed, color="#b0b0ac"];
    s3 -> u4 [style=dashed, color="#b0b0ac"];
    s3 -> wake [color="#3a7d5c", style=dashed];
}
