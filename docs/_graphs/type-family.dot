// The type family as a BLACK-BOX OVERVIEW: one foundry, seven faces,
// three tiers, two choosers, two askers — all sealed. No glyph
// inventories, no px matrices, no per-face ask counts on this figure:
// the boxes open into their own sketches on this page
// (type-family-faces.dot, type-family-tiers.dot, type-family-asks.dot).
// The arithmetic (every glyph count, raster byte total and ask count)
// is re-derived with SystemExit-failing parsers by
// docs/tools/gen_perf_glyphs.py at figure time — the glyph ladder
// (verification/performance.rst) is its narrative twin. FONTS: 12 pt
// everywhere = the page's 16 px body text at 1:1, kept inside the
// content column so object{max-width:100%} never scales it down.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph type_family {
    rankdir=TB;
    label="The type family in black boxes — foundry, seven faces, tiers, askers";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    srcs [label="THE FOUNDRY —\nlv_font_conv,\nBpp 4, no-compress",
          style="rounded,filled,dashed", fillcolor="#eef0ee", color="#5c7fb8", fontcolor="#27405e"];
    askers [label="TWO ASKERS —\nscreens.c 43 ·\nstyles.c 4, nobody else",
            fillcolor="#d7ecef", color="#0e7490", fontcolor="#155e75"];
    faces [label="SEVEN FACES —\nfonts.h externs\nexactly these seven",
           fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    choose [label="TWO CHOOSERS —\nCMake FONT_DIR ·\nuisim --panel N",
            style="rounded,filled,dashed", fillcolor="#fdf7e6", color="#b07d10", fontcolor="#6b4e08"];
    tiers [label="THREE TIERS — one dir per panel,\nfonts/ · fonts_p4/ · fonts_knob/\nIDENTICAL symbol names",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.8];

    srcs -> faces [color="#7c3aed", fontcolor="#4c1d95", style=dashed];
    askers -> faces [color="#2b5fb0", fontcolor="#1e3f70"];
    faces -> tiers [color="#5c7fb8", fontcolor="#27405e", penwidth=1.6];
    choose -> tiers [color="#b07d10", fontcolor="#6b4e08"];
}
