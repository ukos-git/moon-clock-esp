// The knob battery gauge — black-box view: one ADC read path, two
// honest placeholders — the Kconfig calibration pair and the VBUS
// charging heuristic. Every edge verified in
// knob/components/knob_battery/knob_battery.c (init :47, cell_mv :88,
// percent :120, charging :138) and knob/components/knob_ui/
// knob_battery_ui.c (attach :157, timer_cb :127, geometry + palette
// defines :52-70), with the attach sites at knob/main/main.c:501-502.
// The read path: knob_battery_init (main.c:501, inside the P1 umbrella)
// — adc_oneshot unit ADC_UNIT_1, channel KNOB_BATTERY_ADC_CHANNEL
// (GPIO 1 = ADC1_CH0 — ADC2 is unusable with the radio on), 12 dB
// attenuation; either failure logs "gauge off" and leaves s_adc NULL —
// every entry point then inert. eFuse curve-fitting calibration scheme;
// its ABSENCE is not fatal — linear raw approximation: raw x
// 3100/4095 (~3100 mV full scale at 12 dB; 775/1023 at 10-bit);
// placeholder accuracy either way. knob_battery_cell_mv:
// adc_oneshot_read -> raw_to_voltage (or the fallback) -> x
// KNOB_BATTERY_DIV_NUM/_DEN (2/1 = the 10K/10K divider) -> cell mV;
// the FIRST read logs "raw -> mV sense -> mV cell" — the bench line the
// multimeter ritual checks against. THE FIRST PLACEHOLDER:
// knob_battery_percent (mv - MV_EMPTY) x 100 / (MV_FULL - MV_EMPTY),
// clamped 0..100 — 3300..4200 mV is the plan's sanctioned LiPo pair
// until the multimeter ritual lands the honest numbers. THE SECOND
// PLACEHOLDER: knob_battery_charging — mv >=
// KNOB_BATTERY_CHARGING_MV (4400; 0 = bolt off) is read as "on the
// dock": a cell far over the 4200 mV ceiling is the docked-USB
// signature (bench ~4522 mV) — a HEURISTIC, not a signal, because the
// top rail may measure VBUS rather than the cell.
// The hardware side (pin, divider, rail ambiguity) is
// docs/_graphs/knob-wiring.dot; the bench verdict (multimeter ritual,
// 4522 mV dock signature) is docs/devices/knob.rst; the iOS-style
// icon's four states on the one-minute tick are knob-battery-ui.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph knob_battery {
    rankdir=TB;
    label="The knob battery gauge — one ADC read path, two honest placeholders";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.4];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    init [label="init :47 — ADC1_CH0\n(GPIO 1), 12 dB;\nfail → \"gauge off\"\n+ NULL, all inert",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    cali [label="eFuse calib, else\nraw × 3100/4095 —\nplaceholder accu-\nracy either way",
          fillcolor="#efece4"];
    cell [label="cell_mv :88 — ×2/1\nthe 10K/10K divi-\nder; first read\nlogs the bench line",
          fillcolor="#efece4"];
    pct [label="percent :120 —\nMV_EMPTY..MV_FULL\nplaceholder pair\n3300..4200, clamped",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
    chg [label="charging :138 —\n≥ 4400 mV reads\n\"on the dock\" (~4522\nbench) — heuristic",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08", penwidth=1.6];
    view [label="the iOS-style icon\n— detail in\nknob-battery-ui\n.dot",
          style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
          fontcolor="#3f3f3f"];

    init -> cali [label="scheme fails →\nraw fallback"];
    cali -> cell;
    cell -> pct;
    cell -> chg [style=dashed];
    pct -> view [style=dashed];
    chg -> view [style=dashed, color="#b07d10"];
}
