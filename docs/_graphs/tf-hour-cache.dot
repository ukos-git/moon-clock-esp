// The TF hour cache as a black box: what a warm hour is, where the
// folder's key comes from, who may touch the card, and why a missing
// card is a NORMAL path. The internals live in the two detail
// sketches:
//   tf-hour-cache-card.dot   the folder, the hour key, meta.txt, the
//                            bounded window
//   tf-hour-cache-flow.dot   the two producers, the holds-off rule,
//                            the lazy mount and the ready posture
// Every edge verified in components/moon/tfcache/moon_tfcache.c and
// the core-1 producers in components/ui/moon_ui.c (hourly producer,
// boot replay producer, tfcache_set_new_moon_floor). The prose on
// implementation/animations.rst owns the cache POLICY details (the
// commitizen-set calcver, the two bounded-window rules, the lazy
// decode buffer from task #38); this sketch draws the SHAPE.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph tfcache {
    rankdir=TB;
    label="The TF hour cache — a warm hour, its folder, its producers";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    producers [label="THE TWO PRODUCERS —\ncore 1, ONE caller at\na time by construction",
               fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    key [label="THE FOLDER KEY —\ncalcver · target ·\nbakepx",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    card [label="THE CARD — one gray\nJPEG per HOUR, one\nsynodic cycle ≈ 709",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    mount [label="the lazy mount —\nfirst producer pays\nthe ~1 s probe once"];
    evict [label="the bounded window —\nevict past the floor,\nlist/store agree",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    ready [label="tfcache_ready() false\n= NORMAL — bake every\nhour, silently",
           fillcolor="#f2f2f2", color="#6b7280", style="rounded,filled,dashed"];

    producers -> card [color="#2b5fb0", penwidth=1.6];
    key -> card [style=dashed, color="#b07d10"];
    producers -> mount [style=dashed];
    card -> evict [style=dashed, color="#b07d10"];
    mount -> ready [style=dashed];
    ready -> producers [style=dashed, constraint=false];
}
