// The S3's three buses opened — the Waveshare datasheet pin map,
// drawn as bus bars with their members (Waveshare datasheet, the
// same numbers the vendored BSP's config uses):
//   QSPI     CS 12, PCLK 38, D0-D3 4-7, RST 39 -> CO5300 466x466
//            AMOLED, RGB565, no alpha, brightness register 0x51.
//   I2C      SCL GPIO14, SDA GPIO15: CST9217 capacitive touch,
//            QMI8658C IMU (accel+gyro), TCA9554 8-bit IO expander,
//            PCF85063A RTC on 32.768 kHz.
//   I2S      SCLK 9, MCLK 42, LCLK 45, DOUT 8 -> ES8311 codec.
//   The ALM line (orange, bold) is the RTC alarm output landing on
//   the TCA9554 - see s3-wiring-wake.dot for what that means.
// The PSRAM note (DMA staged via internal RAM) is the flush-path
// story in implementation/display.rst, not a wiring fact.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph s3_wiring_bus {
    rankdir=LR;
    label="The S3's buses, pin by pin — Waveshare datasheet";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.3, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    s3 [label="ESP32-S3", fillcolor="#efece4", penwidth=1.6];
    bqspi [label="QSPI — CS 12 ·\nPCLK 38 · D0-D3\n4-7 · RST 39"];
    bi2c [label="I²C — SCL 14 ·\nSDA 15"];
    bi2s [label="I²S — SCLK 9 ·\nMCLK 42 · LCLK 45\n· DOUT 8", fillcolor="#efeef2"];
    co5300 [label="CO5300 AMOLED —\n466×466 · no alpha", fillcolor="#efece4"];
    cst [label="CST9217 touch"];
    qmi [label="QMI8658C IMU"];
    tca [label="TCA9554 expander"];
    pcf [label="PCF85063A RTC\n32.768 kHz"];
    es [label="ES8311 codec"];

    s3 -> bqspi;
    bqspi -> co5300;
    s3 -> bi2c;
    bi2c -> cst;
    bi2c -> qmi;
    bi2c -> tca;
    bi2c -> pcf;
    s3 -> bi2s;
    bi2s -> es;
    pcf -> tca [label="ALM line", color="#b5643a", penwidth=2.2, style=bold,
                fontcolor="#8a3d18", constraint=false];
}
