// The core's public surface in one picture — the black-box pass: the
// three headers, the definitions behind them, and the two caller
// families, sealed; every quote and line number lives in the detail
// sketches and the page caption. Every edge was verified in code
// before drawing (comment-stripped greps — the tfcache "gray565" hit
// is a COMMENT at components/ui/moon_tfcache.c:18, not a call):
//   api-surface-headers.dot  the contract census — headers to entries,
//     with the dashed islands nobody outside the core ever calls
//   api-surface-device.dot   moon_ui.c and knob_moon.c, blue call edges
//   api-surface-host.dot     the host tools, teal call edges
// The bake's per-pixel model is moon-core-flow.dot; the dark-side
// branch is dark-side.dot; the gray->RGB565 dictionary and the
// rotation's last-mile internals are rotate-lut.dot; the compile
// multiplicity of every TU drawn here is the sharing ladder
// (verification/performance.rst).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph api_surface {
    rankdir=TB;
    label="The core's surface in one picture — 23 entries, three headers";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.6];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    device [label="THE DEVICE CALLERS —\nmoon_ui.c + knob_moon.c;\n17 of the 23 have a live caller",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    host [label="THE HOST TOOLS — main.c (the\ngate), bench.c, uisim/stubs.c —\nplus two probes linked by nobody",
          fillcolor="#d7ecef", color="#0e7490", fontcolor="#155e75"];
    headers [label="THE CONTRACT — three headers in\ncomponents/moon/include: moon.h\n16 · moon_event.h 4 · moon_assets.h 3",
             fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    core [label="THE DEFINITIONS — core + the two\nseam backends; pure C, no esp_/\nlv_ call in the math path"];
    seam [label="THE ASSET SEAM — one seam, two\nbackends — the bake's caller\nnever sees who answers",
          fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    device -> headers [color="#2b5fb0", penwidth=1.6];
    host -> headers [color="#0e7490", penwidth=1.6];
    headers -> core;
    core -> seam [color="#b07d10", style=dashed];
}
