// The settings WiFi scan's panel traffic hold (task #30) as a black
// box — who arms it, what the storm eats, who releases it. The
// ordering rules and bench numbers live in the detail sketches:
//   scan-panel-hold-arm.dot      the entry side: arm BEFORE the
//                                kickoff, the leave-keeps-the-guard
//                                rule, the repro numbers
//   scan-panel-hold-release.dot  the tick side: poll ordering, the
//                                radio-really-over release with its
//                                4 s tail, the heal repaint
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph scan_hold {
    rankdir=TB;
    label="The scan hold — arm on the scan, release on the radio";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    scr [label="THE SETTINGS SCREEN —\narms the guard, never\nowns it",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    hold [label="THE HOLD — refcounted,\n45 s cap, re-entry\nextends it",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    scan [label="THE SCAN TASK — the\ncompletion-thief",
          fillcolor="#efece4"];
    stub [label="HELD STATE — writers\nstubbed, flush_cb\nanswers READY"];
    tick [label="THE UI TICK — owns\nthe release",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    heal [label="THE HEAL — release\nrepaints the whole\nscreen, wherever the\nuser went",
          fillcolor="#efece4"];

    scr -> hold;
    scr -> scan;
    scan -> stub;
    hold -> stub;
    scan -> tick [style=dashed];
    tick -> heal;
}
