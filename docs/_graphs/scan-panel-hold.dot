// The settings WiFi scan's panel traffic hold (task #30) — who arms it,
// who releases it, and why the guard must follow the scan, not the screen.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph scan_hold {
    label="The settings WiFi scan hold: arm follows the scan kickoff, release follows the radio session — never the screen (task #30)";
    labelloc="t";
    fontname="Helvetica"; fontsize=18;
    node [fontname="Helvetica", fontsize=12, style="rounded,filled",
          shape=box, width=1.8, height=0.5,
          fillcolor="#f2f2ef", color="#525252", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=10, color="#8a8a8a", penwidth=1.3];

    subgraph cluster_entry {
        label="the settings screen (screens.c) — starts, but never owns, the guard";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        arm [label="settings_wifi_screen_refresh\nscan_panel_hold_arm() BEFORE\nwifi_scan_begin — the storm starts\nwhen the scan task reaches esp_wifi_init",
             fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
        leave [label="leaving mid-scan (password →\nlist → home): deliberately does\nNOT cut the guard — the user's\npath lands the home switch's atomic\nflush INSIDE the running storm",
             fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    }

    scan [label="the scan task: esp_wifi_init firmware-load\n+ the active scan — the completion-thief\n(bench repro, 2026-11-12: ~400 co5300 write\nfailures + 2 silently DROPPED strips over the\nclock row y 176..214 / 214..252 in ~3 s)",
          fillcolor="#efece4"];
    hold [label="moon_ui_panel_traffic_hold_ext — REFCOUNTED\n45 s cap (covers the 0-AP four-retry worst case);\nlist re-entry while a hold is live EXTENDS the cap\ninstead of double-guarding",
          fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    dropped [label="while held: panel writers are stubbed and\nflush_cb answers READY — the drop is permanent:\nnothing re-invalidates those strips, the clock\nrow keeps whatever the last full paint left",
              fillcolor="#eef0ee"];

    subgraph cluster_tick {
        label="the GENERIC ui tick (actions.c) — owns the release";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525c78";
        fontsize=13; fontcolor="#1e3f70";

        poll [label="screens_wifi_scan_hold_poll\nregistered BEFORE the repaint poll,\nso the release's stamp is seen by\nthe same tick's expiry check",
              fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        release [label="release only when the radio session\nis REALLY over (wifi_scan_in_progress\nfalse) — with the sync path's proven\n4 s esp_wifi_stop/deinit teardown tail",
                  fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        heal [label="the release's whole-screen repaint:\nmoon_ui_panel_repaint_pending →\nlv_obj_invalidate(active) heals\neverything the storm ate, wherever\nthe user went meanwhile",
                fillcolor="#efece4"];
    }

    arm -> hold [color="#2b5fb0", penwidth=1.6, fontcolor="#1e3f70", label="arm before kickoff"];
    arm -> scan [label="kickoff"];
    scan -> dropped [label="steals QSPI\ntrans-done"];
    hold -> dropped [label="writers held;\nflush_cb says ready"];
    scan -> poll [style=dashed, label="the poll watches\nwifi_scan_in_progress"];
    poll -> release;
    release -> heal;
    leave -> hold [style=dashed, color="#b07d10", fontcolor="#6b4e08", label="the guard stays — the\nfirst cut released here\n(screen tick + loadScreen)\nand re-opened the drop"];
}
