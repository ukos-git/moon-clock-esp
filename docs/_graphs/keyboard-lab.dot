// The round-keyboard study as a BLACK-BOX OVERVIEW: the corpus, the
// constraint set, the thirteen methods, and the one ship. No
// per-method verdicts, no venue numbers, no strike reasons on this
// figure: the boxes open into their own sketches on this page
// (keyboard-lab-corpus.dot, keyboard-lab-constraints.dot,
// keyboard-lab-methods.dot). The three tracked sources this page
// must agree with: docs/research/circular-keyboard-alternatives.md
// (report of 2026-11-01, 37 sources), the lab's own CARDS/OFF tables
// (docs/_static/keyboard/round-keyboard-lab.html), and the shipped
// wheel (components/ui/screens.c); docs/tools/gen_perf_certainty.py
// re-asserts the same relations at figure time. The wheel's own
// machine is wheel-commit.dot on keyboard.rst; the WPM arithmetic is
// the certainty ladder (verification/performance.rst). FONTS: 12 pt
// everywhere = the page's 16 px body text at 1:1, kept inside the
// content column so object{max-width:100%} never scales it down.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph keyboard_lab {
    rankdir=TB;
    label="The thirteen in black boxes — corpus, constraints, methods, the ship";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    corpus [label="THE CORPUS — 37 sources,\nvenue + year + headline\nnumber behind every vouch",
            fillcolor="#faf8f3", color="#525252"];
    constraints [label="SIX CONSTRAINTS — disk ·\ntouch · no sensors · IMU ·\ntask · firmware budget",
                 fillcolor="#eceff1", color="#525252"];
    methods [label="THIRTEEN METHODS — nine\noperable at the device's own\ntimings, four off-hw cards",
             fillcolor="#f6f9fd", color="#525252", penwidth=1.6];
    wheel [label="THE SHIP — sweep wheel v2\nwith what it KEPT from the\nrejects marked on the edges",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];

    corpus -> methods [color="#2b5fb0", fontcolor="#1e3f70"];
    constraints -> methods [style=dashed, color="#b91c1c", fontcolor="#7f1d1d"];
    methods -> wheel [style=dashed, color="#7c3aed", fontcolor="#4c1d95"];
}
