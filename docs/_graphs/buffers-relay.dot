// The relay as a BLACK-BOX OVERVIEW: the expensive bake leg runs
// OUTSIDE both keys (into the bounce), publish is one brief image-key
// block, the show is one atomic lv_refr_now, and every panel write
// rides the panel key. No holder lists, no line numbers on this
// figure — the painter's three legs open into
// docs/_graphs/buffers-relay-painter.dot (this page); the asks with
// their timeouts are docs/_graphs/guards-keys.dot; the strip staging,
// accept-retry anatomy and the witnesses belong to
// docs/_graphs/flush-path.dot (display.rst); the core's data flow into
// the bounce to docs/_graphs/moon-core-flow.dot (core-c.rst) —
// cross-refs kept reciprocal there too. Provenance of every quote (all
// in components/ui/moon_ui.c unless named): buffers :280-282/:1031,
// keys :315/:323, tick :186/:2634, bounce compute bake (the strip loop
// + rows watermark, moon_bake_progress — the reveal-bake :1281-92/
// :1399-1400 it cites predates the 2026-11-24 compute-progress change;
// the reveal's bounce->s_rgb band edge is gone with it),
// convert :1455-69, whole bake :1542-47, producer :1637-1721, done legs
// :1794-1801, show legs :2474-34, watchdog :588-96/:2559, wrapper
// :599-690, fade-in :3255-68, fade_ramp :3036-49; relief
// moon_esp_assets.c :92-115. FONTS: 12 pt everywhere = the page's 16 px
// body text at 1:1, kept inside the content column so
// object{max-width:100%} never scales it down.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph buffers_relay {
    rankdir=TB;
    label="The relay — the costly leg lock-free, publish one keyed block, the show one atomic flush";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.18,0.11", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    mill [label="THE MILL · core-1 producers\nthe TF hour fetch or the ~1.3 s bake\n— runs into the bounce, NO keys",
          fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.8];
    relief [label="the relief wall — 4 MB,\none packed cell per bake pixel",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    bounce [label="s_hourly_gray — the bounce\nthe desk no key guards",
            fillcolor="#f6e7dc", color="#b5643a", fontcolor="#8a3d18"];
    bootbake [label="the OTHER shape — the boot /\nday-tick bake: WHOLE bake inside\nthe image key",
              style="rounded,filled,dashed"];
    sframe [label="s_frame — the COMPLETE\ngray frame (160 KB)"];
    srgb [label="s_rgb — RGB565 (320 KB)\nthe ONLY buffer the screen reads",
          fillcolor="#fbeae5", color="#c2410c", fontcolor="#7c2410", penwidth=1.6];
    show [label="THE SHOW — one atomic\nlv_refr_now under the IMAGE key",
          fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    wrapper [label="the draw_bitmap wrapper — every\nstrip takes the PANEL key",
             fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
    panel [label="staged internal-RAM strips\n→ QSPI/DSI DMA → panel"];

    relief -> mill [color="#b07d10", fontcolor="#6b4e08", label="built once at boot"];
    mill -> bounce [color="#b5643a", fontcolor="#8a3d18", label="the expensive leg,\nLOCK-FREE"];
    bootbake -> sframe [color="#b07d10", fontcolor="#6b4e08"];
    bounce -> sframe [color="#2b5fb0", fontcolor="#1e3f70",
                      label="PUBLISH — one brief\nimage-key block"];
    sframe -> srgb [color="#2b5fb0", fontcolor="#1e3f70", label="LUT convert"];
    srgb -> show [style=dotted, color="#c2410c", fontcolor="#7c2410",
                  label="s_dsc.data"];
    show -> wrapper [label="strips, one by one"];
    wrapper -> panel;
}
