// The alarm lifecycle as a black box — one scheduler writes both
// boards' arms (the S3's ALM pin, the P4's esp_timer one-shot), both
// lands converge on action_alarm_triggered in the LVGL task. Every
// edge verified in components/clock/clock_alarm_scheduler.c,
// clock_interrupt.c, clock_cb.c, main/main.cpp and components/ui/
// actions.c; the internals live in the detail sketches:
//   alarm-lifecycle-write.dot  the rule setters, the file, the
//                              zero-rules disarm invariant, the row
//   alarm-lifecycle-fire.dot   the two fire paths and the shared poll
// The wake doors around a ring (and the dismiss bypass) are
// docs/_graphs/wake-doors.dot; the trust gate in front of the P4 poll
// is time-chain-trust.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph alarm_lifecycle {
    rankdir=TB;
    label="The alarm lifecycle — file to ring in six sealed steps";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.35, ranksep=0.45];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    write [label="THE RULE WRITE — the\nscheduler rewrites\nalarm.txt whole",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    arm [label="ARMING — zero rules\ndisarm BOTH arms;\n≥ 1 arms the board",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    fire [label="THE TWO FIRES — S3\nALM pin polled; P4\nsoftware one-shot"];
    pollstep [label="THE SHARED POLL — one\n1300 ms lv_timer,\nboth branches",
              fillcolor="#efece4"];
    act [label="THE RING — action_\nalarm_triggered on\nthe LVGL task",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    dis [label="THE DISMISS — touch\nends the show; the\nnext fire is armed",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    write -> arm;
    arm -> fire;
    fire -> pollstep;
    pollstep -> act [color="#2b5fb0", penwidth=1.6];
    act -> dis;
}
