// The portable core's data flow — black-box view: one int64 UTC epoch
// in, one whole-panel frame out. components/moon/core is board-blind,
// allocation-free and shared VERBATIM (device = host_sim = knob): the
// same .c files run in the bench (C), in check_gate (NASA refs) and in
// uisim (real screens, three PANEL_SIZEs). Inside the core box:
// moon_geometry (moon_astro.c + vendored ERFA, O(1), < 0.05 ms host,
// once per bake) -> moon_bake_rows (per-pixel Lambert + relief + art,
// publishes ROWS as they finish) -> moon_render/moon_fixp (moon_rotate
// Q15.15 gather + quarter table, moon_gray565 + warm flag), fed by the
// pre-baked assets (albedo 864x432 S3/knob, 2048x1024 P4; DEM
// 2048x1024, knob 1024x512), the boot-built relief gradient cache
// (int8, 0.003 rad steps, ~1.3 s S3 / 727 ms knob) and moon_event
// (classify once -> gray->RGB565 tint LUT — blood-moon occlusion rides
// the LUT). Device side (components/ui/moon_ui.c), the ONLY panel
// writer: core-1 producers (NEVER concurrent — the replay gate holds
// the hourly probe; hourly refresh, boot replay, day tick) bump a row
// watermark under s_rgb_mtx that free-runs regardless of the tick; the
// tick's bake reveal walks black canvas -> one completed band per 50 ms
// -> heal the OLD frame on abort; publication is ONE atomic whole-panel
// lv_refr_now under s_rgb_mtx + drain witness, s_frame never touched by
// a reveal. Details: moon-core-flow-core.dot and
// moon-core-flow-panel.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph moon_core_flow {
    rankdir=TB;
    label="The portable core: one epoch in, one frame out — the SAME .c files on host and device";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.45];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    epoch [label="UTC epoch\n(one int64)",
           fillcolor="#efece4"];
    core  [label="the portable core —\nboard-blind, allocation-\nfree, shared VERBATIM",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    show  [label="ONE atomic whole-panel\nlv_refr_now under\ns_rgb_mtx + witness",
           fillcolor="#f6e7dc", color="#b5643a", fontcolor="#8a3d18", penwidth=1.6];
    producers [label="core-1 producers —\nNEVER concurrent",
               fillcolor="#efece4"];
    host [label="host_sim — the same\n.c files: bench,\ncheck_gate, uisim",
          style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
          fontcolor="#3f3f3f"];
    detail [label="detail: -core and\n-panel",
            style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
            fontcolor="#3f3f3f"];

    epoch -> core [color="#2b5fb0", penwidth=1.6];
    core -> show [color="#b5643a", penwidth=1.6, label="gray rows →\ns_frame + s_rgb"];
    producers -> core [style=dashed, label="arm"];
    producers -> show [style=dashed, color="#b5643a"];
    epoch -> host [style=dashed];
    core -> detail [style=dashed, arrowhead=none];
}
