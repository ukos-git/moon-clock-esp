// The three SPIFFS files, formats in full (companion to
// spiffs-store.dot). wifi_credentials.txt — GITIGNORED, line 1 SSID,
// line 2 password; the tracked example is what ships, so secrets never
// enter the tree; wifi.c read_wifi_credentials takes the first
// non-comment line as SSID and the second as password. alarm.txt —
// tracked default (comments-only "# no alarms" since 2026-11-19 — a fresh
// flash must not arm an unasked-for ring); five-field cron, one rule per
// line (e.g. "0 7 * * 1-5" = 7:00 Mon–Fri); day_of_month + month are
// ignored; a zero-rule boot MUST clock_clear_alarm or a stale time fires
// a phantom alarm (memory cec0efd). settings.txt — GITIGNORED;
// "key = value" pairs, # comments skipped; six range-validated keys,
// each falling back to its #ifndef-seeded Kconfig default; the file
// carries a two-line "do not edit by hand — a full flash resets this
// file" header written by settings_store_save. All three live in the 64
// K storage partition baked from spiffs/ on every build — but runtime-
// owned: a full flash clobbers them and the settings screens
// re-create the files.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph spiffs_store_files {
    rankdir=LR;
    label="The three files on the card of flash — their formats";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.55];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    part [label="the 64 K storage\npartition",
          shape=note, fillcolor="#e8e8e4", color="#525252",
          fontcolor="#1e3f70"];
    creds [label="wifi_credentials\n.txt — GITIGNORED:\nline 1 SSID,\nline 2 password",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    alarm [label="alarm.txt —\nfive-field cron,\none rule per line;\ncomments-only =\nno alarms",
           fillcolor="#efece4"];
    set   [label="settings.txt —\n\"key = value\" ·\nsix range-checked\nkeys, Kconfig\nfallbacks",
           fillcolor="#efece4"];

    part -> creds;
    part -> alarm;
    part -> set;
}
