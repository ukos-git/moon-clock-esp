// The sleep-entry ladder as a black box: awake -> light sleep (which
// ARMS the deep countdown at entry) -> the countdown -> the two
// guards -> deep sleep -> the shared wake tail. Every edge verified
// in components/clock/clock_idle.c, settings_store.c, main/main.cpp
// (:625/:629) and components/ui/actions.c
// (action_switch_to_light_sleep_screen :1476,
// action_switch_to_deep_sleep_screen :1185). The guard internals are
// docs/_graphs/sleep-entry-guards.dot; the exit side — which doors
// wake it and what the tail does — is docs/_graphs/wake-doors.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph sleep_entry {
    rankdir=TB;
    label="The sleep ladder — awake, lighter, deeper, back again";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.42];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    awake [label="AWAKE — idle monitor\non, tick 10 ms, panel\n100 %, WiFi up",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    light [label="LIGHT SLEEP — radio\nDOWN, tick 100 ms,\nclock 20 % / dim 25 %",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    count [label="the COUNTDOWN —\narmed AT ENTRY, ticks\nat 1 Hz"];
    guards [label="the GUARD LADDER —\ndemo mode, P4 pending\nalarm: stay lighter",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    deep [label="DEEP SLEEP — clock\nHIDDEN, backlight OFF,\napp-level on the P4",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    tail [label="the WAKE TAIL — the\nshared action_wake_\nscreen (wake-doors)"];

    awake -> light;
    light -> count [style=dashed];
    count -> guards;
    guards -> deep;
    deep -> tail;
}
