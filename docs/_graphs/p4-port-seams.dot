// The P4 port as seams, as a black box: one app tree, every board
// fact behind one gate. The internals are opened in the detail
// sketches:
//   p4-port-seams-app.dot    the four board-blind components and the
//                            shim they all funnel through
//   p4-port-seams-chips.dot  the P4's two chips — the JD9365 panel
//                            and the ESP32-C6 radio over SDIO
// The one identity that survives every split: the shim
// (components/board) is the ONLY place "S3" and "P4" coexist as an
// #if. The esp_wifi call leaves wifi_manager.c unchanged and arrives
// at the C6 through esp_wifi_remote + esp_hosted. The build side is
// the 3-file defaults split (sdkconfig-merge.dot) with its own build
// dir (-B build/p4) and own lock (dependencies.lock.p4) — a stray
// board line in the wrong file is the CMakeLists' FATAL_ERROR.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph p4port {
    rankdir=TB;
    label="The P4 port as seams — one app tree, one gate";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    app [label="ONE APP TREE — moon core,\nui, clock, wifi: above the\nshim, everything is\nboard-blind",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    shim [label="THE SEAM — components/\nboard: the only place S3\nand P4 coexist as an #if\n(display init, brightness)",
          fillcolor="#f4e8e6", color="#b91c1c", fontcolor="#7a1a1a", penwidth=1.6];
    chips [label="THE P4's TWO CHIPS — the\nJD9365 DSI panel, the\nESP32-C6 radio over SDIO",
          fillcolor="#efece4"];
    build [label="THE BUILD — 3-file\ndefaults split, -B\nbuild/p4, own lock",
           fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];

    app -> shim [label="panel-scaled flush"];
    shim -> chips;
    build -> shim [style=dashed];
    build -> app [style=dashed];
}
