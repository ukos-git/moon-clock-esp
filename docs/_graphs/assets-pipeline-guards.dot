// The referee side, opened (verified before drawing):
//   Kconfig MOON_ALBEDO_W carries the per-board widths — 864 on
//   S3/knob, 2048 on P4 (the 'default X if BOARD_P4' pattern).
//   The three root-CMakeLists configure guards, all FATAL_ERROR — ONE
//   block run by all three boards (the knob builds through the same
//   root CMakeLists with -D KNOB_BOARD=ON, so it runs the same block;
//   its only difference is the skipped width cross-check, no
//   MOON_ALBEDO_W Kconfig mirror): the
//   width is EVEN (equirect 2:1, height = width/2); manifest alb_w
//   == CONFIG_MOON_ALBEDO_W (a blob baked for another board is a
//   BUILD error); manifest combined_bytes <= the moon_assets row of
//   the partition CSV this build actually uses.
//   idf.py flash lands the blob with
//   esptool_py_flash_to_partition(flash "moon_assets" bin) — a
//   MISSING blob is a WARNING only: the app boots without the moon.
//   The host image gate consumes the SAME textures: check_gate
//   --target s3|p4|knob, and it exit 2s on a sim binary built
//   against the other board's texture — the bytes the device boots
//   are the bytes the gate grades.
// The sealed version is assets-pipeline.dot; the bake side is
// assets-pipeline-bake.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph assets_pipeline_guards {
    rankdir=TB;
    label="The referees — FATAL_ERRORs at configure, a gate on the same bytes";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.35, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    kconf [label="Kconfig MOON_ALBEDO_W\n— 864 S3/knob,\n2048 P4",
           fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    inputs [label="the manifest + blob\nfrom out/<target>/ —\nguard input & witness",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    g1 [label="width EVEN —\nequirect 2:1"];
    g2 [label="manifest alb_w =\nKconfig — a wrong-\nboard blob dies"];
    g3 [label="combined_bytes ≤\nthe partition row\nthis build uses"];
    flash [label="idf.py flash lands\nthe moon_assets row;\nMISSING blob =\nWARNING only",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    gate [label="the image gate eats\nthe SAME textures —\nexit 2 on a stale\nsim binary"];

    kconf -> g1 [color="#b07d10"];
    kconf -> g2 [style=dashed, color="#b07d10"];
    inputs -> g2 [color="#a04a3a"];
    inputs -> g3 [color="#a04a3a"];
    g3 -> flash [label="pass"];
    flash -> gate [style=dotted];
}
