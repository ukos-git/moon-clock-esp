// The alarm ring chain (both AMOLED clocks; docs/ui/alarm.rst) —
// black-box view: baked loops in PSRAM, one short-lived player task
// streaming blocking I2S chunks that self-pace the volume ramp; the
// touch dismiss asks for a fade the task itself performs. Every edge
// verified in components/ui/alarm_audio.c (:200 player, :279 init,
// :306 ring_start, :326 ring_stop, :333 preview), components/ui/
// actions.c (action_alarm_triggered :1109, action_wake_screen :1295)
// and components/ui/screens.c (the sound screen :3140-3160). Boot:
// main.cpp:601, AFTER settings_store_load — bsp_audio_codec_speaker_init
// (idempotent bsp_i2c_init — the touch/IMU/RTC ALREADY run on that bus,
// the ES8311 just joins it — + bsp_audio_init: I2S master TX/RX, mono
// 16-bit @22 050 + the ES8311 DAC with the amp PA pin); loop_gen_all
// bakes the four 1 s loops into PSRAM (4 x 22 050 x 2 B = 176 400 B)
// and s_selected = settings_alarm_sound_id(). SOFT FAIL twice over —
// codec NULL or loops malloc failed (the IMU's rule): the alarm stays
// DISPLAY-ONLY, ring/preview warn and return, the sound selection still
// remembers its choice. The knob has no codec at all:
// knob/components/knob_ui/knob_alarm_audio_stub.c answers the same
// header with silent no-ops and four honest "Silent" names. Details:
// alarm-audio-loops.dot (the four loops) and alarm-audio-play.dot
// (the player task + dismiss fade).
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph alarm_audio {
    rankdir=TB;
    label="The alarm ring chain — PSRAM loops, one short-lived\nplayer task, a fade the task performs itself";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.42];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    init [label="boot init :279 —\nES8311 joins the\nI2C bus, I2S 22 050,\nfour loops baked\nto PSRAM",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    loops [label="the four baked 1 s\nloops — detail in\n-loops.dot",
           fillcolor="#efece4"];
    ring [label="an alarm fires —\ns_busy (ONE player),\nramp 2500 ms, vol\n75, task 6 KiB prio 4",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    play [label="the player task —\ndetail in -play.dot",
          fillcolor="#efece4"];
    fade [label="the player fades\nitself ~150 ms,\ncloses the DAC,\ndeletes itself",
          fillcolor="#efece4", color="#3a6b35", fontcolor="#2c4f29", penwidth=1.6];
    softfail [label="SOFT FAIL: NULL\ncodec / no PSRAM →\nDISPLAY-ONLY",
              fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    knob [label="the knob — codec-\nless silent stub,\nfour \"Silent\"",
          style="rounded,filled,dashed", fillcolor="#f2f2f2", color="#6b7280",
          fontcolor="#3f3f3f"];

    init -> loops [label="bake once"];
    init -> softfail [style=dashed, color="#b07d10"];
    loops -> ring;
    ring -> play [color="#2b5fb0", penwidth=1.6];
    play -> fade [color="#3a6b35", fontcolor="#2c4f29"];
    ring -> knob [style=dashed];
}
