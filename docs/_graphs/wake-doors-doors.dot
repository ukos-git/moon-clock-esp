// The per-door guards, opened (verified before drawing):
//   The touch door (clock_idle.c): indev_read_cb
//   (LV_EVENT_PRESSED/PRESSING, registered by clock_idle_init,
//   clock_idle.c:70/:71) — PRESSED while IDLE -> clock_trigger_idle_
//   wake; while AWAKE the same tap only RESETS the idle timer. That
//   asymmetry is the one-way-door note.
//   The tilt door: the 1 s tilt monitor (moon_ui) samples the
//   QMI8658C and calls clock_idle_notify_tilt_activity (actions.c).
//   It wakes only on DEPARTURE from the settled-pose EMA — two per-
//   state bars (5 deg activity while awake, 20 deg UI_IMU_WAKE_DEG
//   while asleep) held for a 2-sample streak; the <= 1/s rate cap is
//   the 1 Hz call site — raw deltas are the "the clock woke itself"
//   bug class. The full signal chain is tilt-pipeline.dot.
//   The alarm door: action_alarm_triggered sets g_asleep = true (the
//   alarm screen counts as asleep) and g_alarm_active = true. While
//   AWAKE at the ringing screen the idle door cannot fire (tap-while-
//   awake only resets the timer) — alarm_indev_read_cb is the second
//   indev cb that dismisses anyway: g_alarm_active &&
//   !clock_is_idle() -> action_wake_screen on the SAME press.
// The sealed version is wake-doors.dot; the tail is
// wake-doors-tail.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph wake_doors_doors {
    rankdir=TB;
    label="The guards — per-door asymmetry, per-state bars, a bypass";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.45];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    tap2 [label="indev cb — awake tap\nonly RESETS the\nidle timer",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    mon2 [label="the 1 Hz monitor →\nnotify_tilt_activity"];
    dep2 [label="departure from the\nsettled EMA — two\nbars, 2-streak",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    ran [label="the ring sets asleep\n— the alarm screen\ncounts as asleep"];
    byp [label="second indev cb —\nactive, not idle: the\ndismiss bypasses",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    fun2 [label="the one trigger\nfunnel", fillcolor="#efece4", penwidth=1.6];
    tail2 [label="the shared tail —\nwake-doors-tail.dot"];

    tap2 -> fun2;
    mon2 -> dep2;
    dep2 -> fun2;
    ran -> byp;
    byp -> tail2 [color="#b07d10", style=dashed];
}
