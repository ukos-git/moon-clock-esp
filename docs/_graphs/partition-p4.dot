// P4 (32 MB flash) partition layout — partitions_p4.csv, verified
// against the tracked CSV before drawing: bootloader + partition
// table (nvs 24 K + phy 4 K), factory app 9216 K, storage SPIFFS
// 64 K, moon_assets 5120 K (2048x1024 albedo + 2048x1024 DEM =
// 4096 K combined), then unused. The table ends at 14464 K including
// the 64 K prefix; ~17.9 MB stays unused. The binary header stays
// 16 MB, so esptool's size-mismatch warning on this board is
// EXPECTED, not a fault.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph partitions_p4 {
    rankdir=TB;
    label="partitions_p4.csv — P4 4C, 32 MB flash";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.38];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3,
          arrowhead=none];

    boot    [label="bootloader + table —\nnvs 24 K + phy 4 K",
             fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    factory [label="factory (app) —\n9216 K",
             fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    storage [label="storage (SPIFFS) —\n64 K",
             fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    assets  [label="moon_assets — 5120 K\n(2048×1024 albedo +\n2048×1024 DEM)",
             fillcolor="#efece4"];
    free    [label="unused —\n~17.9 MB",
             fillcolor="#f2f2f2", color="#6b7280", fontcolor="#3f3f3f",
             style="rounded,filled,dashed"];

    boot -> factory;
    factory -> storage;
    storage -> assets;
    assets -> free;
}
