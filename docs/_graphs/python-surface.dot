// THE PYTHON SIDE in one picture — the black-box pass: what the
// twelve-module package at assets/images/moon/moon/ is sealed into,
// and the four relationships the repo keeps honest (five tracked files
// import it; two more deliberately do not; it writes the artifacts the
// firmware compiles and flashes; six third parties are imported and
// one pin is never touched). Every relationship was read out of the
// source before drawing (comment-stripped greps — same discipline as
// api-surface.dot); the internals live in the detail sketches, one per
// sealed box:
//   python-surface-imports.dot    the intra-package import arrows
//   python-surface-deps.dot       which module pulls which third party
//   python-surface-products.dot   writers -> artifacts -> firmware ends
//   python-surface-consumers.dot  the five importers, module by module
// The C half of the same interface is api-surface.dot; the gate's
// dataflow is image-gate.dot; the pipeline flow through assets.py is
// assets-pipeline.dot; the compile/flash story is build-seam.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph python_surface {
    rankdir=TB;
    label="The Python side in one picture — modules, products, consumers";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.5, ranksep=0.65];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    consumers [label="THE CONSUMERS — five files\nimport the package; two more\nimport nothing, they shell out",
               fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    pkg [label="THE PACKAGE — twelve modules\nconstants.py is the hub;\nassets.py imports seven",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    deps [label="THIRD PARTIES — six imported\n+ ffmpeg subprocessed; the\nimageio pin is never imported",
          fillcolor="#eceff1"];
    prods [label="WHAT IT WRITES — the asset blob,\nthe compiled header, the fitted\nLUT, the sweep frames + mp4",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    fw [label="THE FIRMWARE ENDS — the header\ncompiled into the core, the blob\nflashed into moon_assets",
        fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    consumers -> pkg [color="#2b5fb0", penwidth=1.6];
    pkg -> deps [style=dashed];
    pkg -> prods [color="#2b5fb0", penwidth=1.6];
    prods -> fw [style=dashed];
}
