// The three-file sdkconfig.defaults split (ESP-IDF kconfgen: the
// per-target file is auto-appended when it exists, LATER FILE WINS),
// verified against the tracked files before drawing:
//   sdkconfig.defaults is loaded for EVERY board: the LVGL 9.6
//   setup, the component-manager manifest, PARTITION_TABLE_CUSTOM,
//   the clock/UI defaults, target = esp32s3.
//   sdkconfig.defaults.esp32s3 (IDF_TARGET=esp32s3): octal PSRAM
//   80 MHz, 240 MHz core, CPU1 idle-WDT off, flush queue depth 1.
//   NOTE: it carries no CONFIG_BOARD_S3=y — the choice default owns
//   the board.
//   sdkconfig.defaults.esp32p4 (IDF_TARGET=esp32p4): BOARD_P4=y,
//   partitions_p4.csv, rev v1.3, PSRAM 200 MHz + the experimental
//   flag, XIP, L2 cache 256 K, PCF85063A off, the C6-over-SDIO pins.
// The live files (gitignored) are the S3's sdkconfig and the P4's
// sdkconfig.p4 — a hand-edited live pin BEATS a Kconfig default
// (first-match-wins defaults; a CONFIG_…=… line in the live file
// wins over every default line), so a changed default needs the
// stale pin deleted. The root CMakeLists' board/target guard
// FATAL_ERRORs when IDF_TARGET and the BOARD choice disagree.
// The build sequence around this is build-flash.dot; the seam the P4
// pins configure is p4-port-seams.dot.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph sdkconfig_merge {
    rankdir=TB;
    label="The sdkconfig merge — one shared file, two per-target files";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.5];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    shared [label="sdkconfig.defaults —\nEVERY board: LVGL, the\nmanifest, partitions,\nclock/UI, target esp32s3",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    s3file [label=".esp32s3 — octal PSRAM\n80 MHz, 240 MHz core,\nCPU1 idle-WDT off,\nflush queue depth 1",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    p4file [label=".esp32p4 — BOARD_P4=y,\npartitions_p4.csv, rev\nv1.3, PSRAM 200 MHz,\nXIP, C6-over-SDIO pins",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    s3live [label="sdkconfig — the S3\nlive config",
            fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    p4live [label="sdkconfig.p4 — the P4\nlive config",
            fillcolor="#efece4", color="#8a8a8a", fontcolor="#3f3f3f"];
    guard [label="root CMakeLists:\nFATAL_ERROR on target /\nboard-choice mismatch",
           fillcolor="#f4e8e6", color="#b91c1c", fontcolor="#7a1a1a", penwidth=1.6];

    shared -> s3file;
    s3file -> s3live;
    shared -> p4file;
    p4file -> p4live;
    s3live -> guard;
    p4live -> guard;
}
