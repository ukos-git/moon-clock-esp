// The moon asset pipeline: LROC/LOLA sources -> per-board blobs -> the
// configure-time guards -> the flashed partition. Rendered inline as SVG
// by sphinx.ext.graphviz (dot on PATH); reference/build-system.rst embeds it.
digraph assets_pipeline {
    label="The moon asset pipeline: one source, three board blobs, three configure-time guards";
    labelloc="t";
    fontname="Helvetica"; fontsize=19;
    node [fontname="Helvetica", fontsize=13, style="rounded,filled",
          shape=box, width=1.8, height=0.5,
          fillcolor="#f2f2ef", color="#525252", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=11, color="#8a8a8a", penwidth=1.3];

    src [label="the sources (shared by all three boards)\nLROC albedo (16-bit TIFF via tifffile)\n+ LOLA DEM — one dataset, per-board\nBAKE resolution only differs",
         fillcolor="#efece4"];
    consts [label="moon/constants.py — the single source\nof truth (widths, DEM quantisation range)\n⇒ moon_consts.h is GENERATED from it",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    cli [label="the CLI\ncd assets/images/moon &&\n.venv/bin/python -m moon.assets\n--target s3 p4 knob",
         fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];

    subgraph cluster_out {
        label="out/<target>/  (gitignored, regenerated)";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#f4f2ec";
        color="#8a8a8a";
        fontsize=14; fontcolor="#6e6e6e";

        blob [label="moon_assets.bin (the flashed blob)\nalbedo u8 at offset 0 (864 wide on\nS3+knob, 2048 on P4), then the int8 DEM\n— the moon_assets.h boot contract",
              fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
        manifest [label="moon_assets_manifest.json\nalb_w · combined_bytes ·\nDEM geometry — the guard's\ninput AND its witness",
                  fillcolor="#efece4"];
        genc [label="moon_assets_gen.c\n(the compiled-in fallback texture;\nalso a moonmedia staleness input)",
              fillcolor="#efece4"];
    }

    hdr [label="components/moon/generated/<t>/\nmoon_consts.h — TRACKED copy\n(the C side's constants; docs\nmoon-consts.rst single-sources it)",
         fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];

    subgraph cluster_guards {
        label="root CMakeLists at configure — all three FATAL_ERROR\n(knob/CMakeLists.txt replicates them for --target knob)";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#f3d6d0";
        color="#a04a3a";
        fontsize=14; fontcolor="#7a2e20";

        g1 [label="MOON_ALBEDO_W even\n(equirect 2:1, height = width/2)"];
        g2 [label="manifest alb_w ==\nCONFIG_MOON_ALBEDO_W\n(a blob baked for another\nboard is a build error)"];
        g3 [label="manifest combined_bytes ≤\nthe moon_assets row of the\npartition CSV this build uses"];
    }

    kconfig [label="Kconfig MOON_ALBEDO_W\n(864 S3/knob · 2048 P4 —\n'… if BOARD_P4' defaults)",
             fillcolor="#f6f1e2", color="#b07d10"];
    flash [label="idf.py flash\nesptool_py_flash_to_partition\n(flash \"moon_assets\" bin)\nMISSING blob ⇒ WARNING only —\nthe app boots without the moon",
             fillcolor="#dfe6f1", color="#2b5fb0", fontcolor="#1e3f70"];
    gate [label="the host image gate consumes the same\ntextures: check_gate --target s3|p4|knob\n(exit 2 on a sim built against the other\nboard's texture)",
           fillcolor="#eef0ee"];

    src -> cli;
    consts -> cli [label="widths + quantisation"];
    consts -> hdr [style=dashed, color="#b07d10", label="generated header"];
    cli -> blob;
    cli -> manifest;
    cli -> genc [style=dashed];
    kconfig -> g1 [color="#b07d10"];
    kconfig -> g2 [style=dashed, color="#b07d10"];
    manifest -> g2 [color="#a04a3a"];
    manifest -> g3 [color="#a04a3a"];
    blob -> g3 [color="#a04a3a"];
    g3 -> flash [label="pass"];
    blob -> flash;
    flash -> gate [style=dotted, label="same bytes the device boots"];
}
