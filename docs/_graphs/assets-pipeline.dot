// The moon asset pipeline as a black box: one source, three board
// blobs, the configure-time guards, the flashed partition. The
// internals are opened in the detail sketches:
//   assets-pipeline-bake.dot    the sources, constants.py, the CLI,
//                               the three outputs
//   assets-pipeline-guards.dot  the FATAL_ERROR trio, the flash, the
//                               image gate that eats the same bytes
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH);
// reference/build-system.rst embeds it.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph assets_pipeline {
    rankdir=TB;
    label="The moon asset pipeline — one source, three blobs, three guards";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.4, ranksep=0.45];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    src [label="THE SOURCES — LROC\nalbedo + LOLA DEM,\none dataset",
         fillcolor="#efece4"];
    cli [label="THE CLI —\npython -m moon.assets\n--target s3 p4 knob",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    out [label="out/<target>/ — the\nblob, the manifest,\nthe gen.c fallback",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    guards [label="THE GUARDS — three\nconfigure-time\nFATAL_ERRORs",
            fillcolor="#f6f1e2", color="#b07d10", fontcolor="#6b4e08"];
    flash [label="THE PARTITION —\nidf.py flash lands\nthe moon_assets row",
           fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];

    src -> cli;
    cli -> out;
    out -> guards [color="#b07d10"];
    guards -> flash [label="pass"];
}
