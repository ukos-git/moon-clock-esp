// The pomodoro cycle — black-box view: a roller release rewrites the
// one rule file, the day-grid arithmetic caches the next ring, the home
// row reads the cache. Every edge verified in components/ui/screens.c
// (the entry cluster :690-724, the stopwatch entry :790-800, the
// rollers + save :818-966, the dial focus + commit :3952/:4085-4105/
// :4261-4275), components/clock/clock_alarm_scheduler.c
// (set_pomodoro_interval :633-646, the whole-file write :500-517,
// reload :523-571, the field caps :95-123, the both-interval reject
// :159-163, the day grid :217-277, the arming funnel :394-481) and
// components/ui/actions.c (refresh_alarm_display :1020-1037, the
// minute-tick refresh :956-959, the registration main.cpp:617). The
// FIRE itself — poll, trigger, ring, dismiss, fire-then-reschedule — is
// docs/_graphs/alarm-lifecycle.dot (the interval rule is just the other
// rule kind that lands there); this family owns the settings-side
// machine: pomodoro-cycle-edit.dot for the glyphs/rollers/dial,
// pomodoro-cycle-grid.dot for the parser + arming funnel + home row.
// FONTS: 12 pt = the page's 16 px body text at 1:1 — kept inside the
// content column.
// Rendered inline as SVG by sphinx.ext.graphviz (dot on PATH).
digraph pomodoro_cycle {
    rankdir=TB;
    label="The pomodoro cycle — a release rewrites the rule file,\nthe grid caches the next ring, the home row reads it";
    labelloc="t"; labeljust="c";
    fontname="Helvetica"; fontsize=12;
    graph [nodesep=0.45, ranksep=0.4];
    node [fontname="Helvetica", fontsize=12, shape=box, style="rounded,filled",
          width=0, height=0, margin="0.16,0.10", fillcolor="#f2f2ef",
          color="#525252", penwidth=1.2];
    edge [fontname="Helvetica", fontsize=12, color="#8a8a8a", penwidth=1.3];

    glyphs [label="alarm-rules screen —\nthree glyphs, one\nrule kind",
            fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    stopwatch [label="stopwatch entry →\nthe pomodoro screen",
                fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    released [label="ONLY a RELEASED\npersists — total < 1\nis REJECTED",
              fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    setter [label="set_pomodoro_\ninterval → full\nreplace + reload",
            fillcolor="#efece4"];
    grid [label="the */N day grid —\ncaches the next\nring",
          fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70"];
    arm [label="the arming funnel —\nPCF ALM or\nesp_timer",
         fillcolor="#dbe7f6", color="#2b5fb0", fontcolor="#1e3f70", penwidth=1.6];
    home [label="the home alarm row —\na VIEW of the cache,\nnever a second\nschedule",
          fillcolor="#efece4"];
    fire [label="the ring: the alarm\nlifecycle's — same\npoll, same fire-then-\nreschedule",
          shape=note, fillcolor="#e8e8e4", color="#525252", fontcolor="#1e3f70"];

    glyphs -> stopwatch;
    stopwatch -> released [label="lift the finger /\ndial commit"];
    released -> setter [color="#2b5fb0", label="total ≥ 1"];
    setter -> grid;
    grid -> arm [color="#2b5fb0"];
    arm -> home;
    arm -> fire [style=dashed, color="#b07d10"];
    home -> fire [style=dashed, arrowhead=none];
}
