digraph S3 {
    label="Waveshare ESP32-S3-Touch-AMOLED-1.75 — component wiring";
    labelloc="t";
    fontname="Helvetica"; fontsize=20;
    node [fontname="Helvetica", fontsize=13, style="rounded,filled",
          shape=box, width=1.7, height=0.5,
          fillcolor="#f2f2ef", color="#525252", penwidth=1.1];
    edge [fontname="Helvetica", fontsize=11, color="#8a8a8a", penwidth=1.3];

    subgraph cluster_soc {
        label="ESP32-S3 SoC";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#e8e8e4";
        color="#525252";
        fontsize=14; fontcolor="#3c3c3c";
        s3 [label="ESP32-S3\ndual-core Xtensa LX7 · 240 MHz\n16 MB flash + octal PSRAM", fillcolor="#e8e8e4"];
    }

    subgraph cluster_qspi {
        label="QSPI display bus";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#f4f2ec";
        color="#8a8a8a";
        fontsize=13; fontcolor="#6e6e6e";
        co5300 [label="CO5300 · 466×466 AMOLED\nRGB565 · no alpha\nbrightness register 0x51", fillcolor="#efece4"];
    }

    subgraph cluster_i2c {
        label="I²C bus  ·  SCL = GPIO14 · SDA = GPIO15";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#eef0ee";
        color="#8a8a8a";
        fontsize=13; fontcolor="#6e6e6e";
        cst9217 [label="CST9217\ncapacitive touch", fillcolor="#eef0ee"];
        qmi8658 [label="QMI8658C\nIMU · accel + gyro", fillcolor="#eef0ee"];
        tca9554 [label="TCA9554\nIO expander (8-bit)", fillcolor="#eef0ee"];
        pcf85063 [label="PCF85063A\nRTC · 32.768 kHz", fillcolor="#eef0ee"];
    }

    subgraph cluster_i2s {
        label="I²S audio bus";
        labeljust="l";
        style="rounded,filled";
        fillcolor="#f1eff3";
        color="#8a8a8a";
        fontsize=13; fontcolor="#6e6e6e";
        es8311 [label="ES8311\ncodec · speaker + mic", fillcolor="#efeef2"];
    }

    flash [label="16 MB flash\n(factory 2 MB · SPIFFS 64 KB\nmoon_assets 2.5 MB)", fillcolor="#eef0ee"];
    psram [label="octal PSRAM\nnot SPI-DMA-capable\n(DMA staged via internal RAM)", fillcolor="#efece4"];

    /* the wake-up problem, called out explicitly */
    not_wake [label="RTC ALM output\n→ TCA9554 pin 3\npolled by a RUNNING CPU\nat 1.3 s (lv_timer)\n\nNOT wired to any ESP wake input",
              fillcolor="#f6e7dc", color="#b5643a", penwidth=2.2,
              fontcolor="#8a3d18", fontsize=12];

    s3  -> flash   [label=""];
    s3  -> psram   [label=""];
    s3  -> co5300  [label="QSPI · CS 12, PCLK 38, D0–D3 4–7, RST 39", dir=both];
    s3  -> cst9217 [label="I²C", dir=both];
    s3  -> qmi8658 [label="I²C", dir=both];
    s3  -> tca9554 [label="I²C", dir=both];
    s3  -> pcf85063[label="I²C", dir=both];
    s3  -> es8311  [label="I²S · SCLK 9, MCLK 42, LCLK 45, DOUT 8", dir=both];

    pcf85063 -> tca9554 [label="ALM line", color="#b5643a", penwidth=2.2, style=bold, fontcolor="#8a3d18"];
    tca9554  -> not_wake [color="#b5643a", penwidth=2.2, style=dashed, fontcolor="#8a3d18"];
    s3 -> not_wake [label="CPU reads expander pin 3\n(no GPIO wake on the S3 path)", style=dashed, color="#b5643a", fontcolor="#8a3d18"];
}
