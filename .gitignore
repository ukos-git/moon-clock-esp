build/
.cmake_build
managed_components/
sdkconfig.old
sdkconfig
sdkconfig.p4
# Per-board component-manager lock (the P4 build resolves a different
# dependency set than the S3; the tracked dependencies.lock is the S3 one).
dependencies.lock.p4
dependencies.lock.knob
assets
warnings.txt
spiffs/*
knob/spiffs/*
!spiffs/wifi_credentials.example.txt
!knob/spiffs/wifi_credentials.example.txt
!knob/spiffs/alarm.txt
host_sim/pole_test
docs/img/frames/
host_sim/uisim/out/
# uisim --panel N builds (build-720/ for the P4; the default build/ is
# covered above)
host_sim/uisim/build-*/
# the P4 host-sim build dir (host_sim/CMakeLists -DMOON_ASSETS_TARGET=p4,
# its own build/ under build-p4/ — the pattern 'build/' alone does not
# match)
host_sim/build-p4/
# ... and the knob one (K7, -DMOON_ASSETS_TARGET=knob)
host_sim/build-knob/
docs/.venv/
docs/_build/
# mooncode's generated source pages (code/gen/ is rebuilt at build time)
docs/code/gen/
# composite_dark.py intermediate frames (vendored output is
# _static/photos/sim_*.png; the scratch dir is a byproduct)
docs/tools/scratch/
# bench recording takes (video.mp4 + serial logs + frames + montages;
# the harness itself in bench/record_demo.py IS tracked)
bench/recordings/

# resident crash-catch daemon logs (live files, not evidence)
.debug-sleep/crashlog/

# docs media: regenerated build outputs (docs/.venv/bin/sphinx-build -b
# media + the docs/tools gen scripts + MEDIA_NASA/MEDIA_VIDEOS slots).
# Sources of truth are the generators + uisim + the vendored hero photos
# (docs/tools/*.webp) + the hand-authored docs/_graphs SVGs — the media
# itself is rebuilt, never committed. LFS now only serves the hero photos.
docs/img/screens/
docs/img/nasa/
docs/img/fade.mp4
docs/_static/photos/
docs/_static/figs/
.debug-touch/coredump.bin
.debug-touch/coredump_raw.bin
