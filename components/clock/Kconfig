menu "Clock Component Configuration"

    config CLOCK_USE_PCF85063A
        bool "External PCF85063A RTC IC"
        default y
        help
            Use the external PCF85063A RTC (with the TCA9554 IO expander)
            as the time base. The S3 board carries it; the P4 4C does not —
            there the time base is the 32.768 kHz crystal-backed internal
            RTC timer (RTC_CLK_SRC_EXT_CRYS) + SNTP, minute ticks are
            detected in software, and the countdown / alarm arming run on
            esp_timer instead of the PCF85063A hardware registers. When
            disabled, clock_set_alarm / clock_enable_alarm /
            clock_clear_alarm become no-ops (the scheduler's s_next_alarm
            cache is the source of truth for the software alarm).

    choice CLOCK_TIME_FORMAT
        prompt "Time display format"
        default CLOCK_TIME_FORMAT_24H
        help
            Choose between 12-hour (AM/PM) and 24-hour time display format.
            Note: The RTC always stores time in 24-hour format internally.
            This setting only affects how time is displayed in the UI.

        config CLOCK_TIME_FORMAT_24H
            bool "24-hour format (00:00 - 23:59)"
        config CLOCK_TIME_FORMAT_12H
            bool "12-hour format with AM/PM (12:00 AM - 11:59 PM)"
    endchoice

    config CLOCK_DEFAULT_TIMEZONE
        string "Default timezone (POSIX TZ format)"
        default "CET-1CEST,M3.5.0/2,M10.5.0/3"
        help
            Default timezone in POSIX TZ format.
            Examples:
            - "CET-1CEST,M3.5.0/2,M10.5.0/3" (Central European Time with DST)
            - "EST5EDT,M3.2.0,M11.1.0" (Eastern Time US with DST)
            - "UTC0" (UTC time)
            - "JST-9" (Japan Standard Time, no DST)
            - "PST8PDT,M3.2.0,M11.1.0" (Pacific Time US with DST)

    config CLOCK_NTP_SERVER
        string "NTP server hostname"
        default "pool.ntp.org"
        help
            Primary NTP server to synchronize time with.

    config CLOCK_NTP_SYNC_INTERVAL_HOURS
        int "NTP sync interval (hours)"
        default 1
        range 1 168
        help
            Interval between NTP synchronizations in hours (1-168).
            The device activates WiFi on demand (wake + the hourly tick
            while at rest on the airplane screen) purely to refresh the
            RTC, then drops back to airplane mode.

    config CLOCK_NTP_TIMEOUT_MS
        int "NTP synchronization timeout (milliseconds)"
        default 10000
        range 3000 30000
        help
            Maximum time to wait for NTP synchronization.

    config CLOCK_IDLE_TIMEOUT_SEC
        int "Idle timeout in seconds"
        default 60
        range 60 1800
        help
            Time in seconds of no user interaction before switching to deep sleep screen.
            The timer resets on any touch/display interaction.

    config CLOCK_IDLE_CHECK_INTERVAL_MS
        int "Idle check interval (milliseconds)"
        default 1000
        range 500 5000
        help
            How often to check for idle timeout (in milliseconds).
            Lower values provide more precise timing but use more CPU.

endmenu
