# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
# SHARED defaults: loaded for every board. Per-board lines live in
# sdkconfig.defaults.<target> (the build system auto-loads the file matching
# the active IDF_TARGET after this one; kconfgen is later-file-wins, so the
# board file overrides anything set here). Keep board-specific symbols OUT of
# this file or they leak into the other board's build.
#
# The target line stays esp32s3 so a plain `idf.py build` (fresh clone, no
# sdkconfig) still guesses the S3 target; the P4 build passes
# -D IDF_TARGET=esp32p4 and its per-target file overrides this line.
CONFIG_IDF_TARGET="esp32s3"
# Flash size header: the S3 has a 16 MB chip; the P4 has a 32 MB chip but the
# binary header still says 16 MB (the spi_flash size-mismatch warning on the
# P4 is expected -- see partitions_p4.csv). Both boards flash a 16 MB header.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
# Obsolete test hook (the synodic sweep now plays at BOOT only, from a
# black screen); kept off and present so existing configs keep
# validating.
CONFIG_UI_MOON_ANIM_ON_WAKE=n
# Light-sleep dusk: the pole-axis spin to the fully unilluminated side;
# the deep-sleep countdown is armed on its last frame.
CONFIG_UI_MOON_DUSK_ENABLE=y
# Clock opacity in light sleep (percent, 0..100): the light-sleep entry
# dims the ONE shared clock widget to this opacity (the panel dim carries
# the readability now, so 100 = no extra alpha is the default).
CONFIG_UI_CLOCK_ALPHA_PCT=20
# Screen switches (e.g. into the settings hub) fade to black with the
# panel's OWN hardware brightness (the CO5300 0x51 command, the same
# dimming the deep-sleep backlight off/on uses): the fade-out ramp
# writes no pixels (the spin keeps moving, its frames just dim), the
# new screen is flushed atomically while the panel is still black, and
# the fade-in ramp brings it back. No strip crawl, no per-step
# re-render. The moon screens switch atomically as always.
CONFIG_UI_SCREEN_SWITCH_FADE=240
# Burn-in spin: settled (at rest) rate 600 s/turn (visible slow creep;
# the old phase-true coast read as a freeze), 8 panel frames/s.
CONFIG_UI_MOON_SPIN_SETTLED_PERIOD_S=600
CONFIG_UI_MOON_SPIN_FPS=8
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
CONFIG_IO_EXPANDER_ENABLE_GPIO_API_WRAPPER=n
# LVGL allocator backend: the C library (NOT the built-in 64 KB static
# internal pool). The tilt clock-roll sets a style transform_rotation on
# the full-screen clock containers; LVGL renders a transformed object
# into ONE unchunked layer of its whole rotated bounding box, allocated
# via lv_malloc. The built-in pool (LV_MEM_SIZE, 64 KB static internal
# RAM) cannot hold a full-panel layer, the alloc returns NULL and LVGL
# dereferences the NULL layer on the first tilt (crash). With the clib
# backend lv_malloc is libc malloc, which on the PSRAM-enabled boards
# places the large layer in PSRAM. Only cost: LV_USE_MEM_MONITOR
# (depends on builtin) -- unused by this UI.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_MIX_ROUND_OFS=128
CONFIG_LV_OBJ_STYLE_CACHE=n
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_THEME_MONO=n
CONFIG_LV_USE_GRID=n
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_)}"
CONFIG_LV_WIDGETS_HAS_DEFAULT_VALUE=n
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_BAR=n
CONFIG_LV_USE_BUTTON=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=y
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
# Debug monitors: nothing in this UI ever creates a perf/sysmon widget
# (the CPU figures came from the IDF task stats), so the monitor code is
# pure flash weight. Snapshot is on: the burn-in spin's UI keep-mask
# captures the active screen into a full-screen draw_buf (moon text and
# icons are kept as pixels) on every screen switch and label change.
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
