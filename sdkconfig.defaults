# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.1 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
# Flash: the board has a 16MB chip (esptool flash_id). The 2MB layout in
# git history was a config choice; the 2048x1024 relief DEM needs the
# headroom (see partitions.csv, moon_assets = 2560K).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# Task watchdog: core 1 runs the bounded moon bakes (a high-priority
# ~2 s/frame full-disk-relief bake for orbit/wake-sweep) plus the spin
# render; together they can starve the CPU1 idle task for a full bake,
# which would trip the 5 s WDT (log-only but noisy). The bakes are
# bounded and self-cancelling, so a permanent core-1 hang is not a
# realistic risk; core 0's idle check (IDF default, on) stays as the
# hang safety net.
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n
# LCD flush queue depth 1: the S3 SPI DMA caps one transfer at 32 KiB
# and PSRAM is not DMA-capable, so every strip is staged into internal
# RAM; depth 1 keeps the peak internal allocation at one ~23 KB strip
# (deeper queues exhausted the heap -> ESP_ERR_NO_MEM, see the vendored
# BSP buffer_height 50->25 fix).
CONFIG_BSP_LCD_TRANS_QUEUE_DEPTH=1
# Obsolete test hook (the synodic sweep now plays at BOOT only, from a
# black screen); kept off and present so existing configs keep
# validating.
CONFIG_UI_MOON_ANIM_ON_WAKE=n
# Light-sleep dusk: the pole-axis spin to the fully unilluminated side;
# the deep-sleep countdown is armed on its last frame.
CONFIG_UI_MOON_DUSK_ENABLE=y
# Screen switches (e.g. into the settings hub) bloom in concentrically
# (center-out 25-row windows) instead of LVGL's top-to-bottom strip
# flush; the moon screens keep the atomic whole-panel invariant.
CONFIG_UI_SCREEN_SWITCH_REVEAL=y
CONFIG_CODEC_ES7243_SUPPORT=n
CONFIG_CODEC_ES7243E_SUPPORT=n
CONFIG_CODEC_ES8156_SUPPORT=n
CONFIG_CODEC_AW88298_SUPPORT=n
CONFIG_CODEC_ES8389_SUPPORT=n
CONFIG_CODEC_ES8374_SUPPORT=n
CONFIG_CODEC_ES8388_SUPPORT=n
CONFIG_CODEC_TAS5805M_SUPPORT=n
CONFIG_IO_EXPANDER_ENABLE_GPIO_API_WRAPPER=n
# LVGL allocator backend: the C library (NOT the built-in 64 KB static
# internal pool). The tilt clock-roll sets a style transform_rotation on
# the full-screen 466x466 clock containers; LVGL renders a transformed
# object into ONE unchunked layer of its whole rotated bounding box
# (up to ~659x659 @ RGB565 ~= 0.9 MB), allocated via lv_malloc. The
# built-in pool (LV_MEM_SIZE, 64 KB static internal RAM) cannot hold that,
# the alloc returns NULL and LVGL dereferences the NULL layer on the first
# tilt (crash). With the clib backend lv_malloc is libc malloc, which on the
# SPIRAM-enabled S3 places the large layer in PSRAM (7.7 MB free). Only cost:
# LV_USE_MEM_MONITOR (depends on builtin) -- unused by this UI.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_MEM_SIZE_KILOBYTES=64
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_COLOR_MIX_ROUND_OFS=128
CONFIG_LV_OBJ_STYLE_CACHE=n
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_USE_THEME_SIMPLE=n
CONFIG_LV_USE_THEME_MONO=n
CONFIG_LV_USE_GRID=n
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_)}"
CONFIG_LV_WIDGETS_HAS_DEFAULT_VALUE=n
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_ARCLABEL=n
CONFIG_LV_USE_BAR=n
CONFIG_LV_USE_BUTTON=n
CONFIG_LV_USE_BUTTONMATRIX=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CANVAS=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_CHECKBOX=n
CONFIG_LV_USE_DROPDOWN=n
CONFIG_LV_USE_IMAGEBUTTON=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LED=n
CONFIG_LV_USE_LINE=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_MSGBOX=n
CONFIG_LV_USE_ROLLER=y
CONFIG_LV_USE_SCALE=n
CONFIG_LV_USE_SLIDER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_SWITCH=n
CONFIG_LV_USE_TEXTAREA=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n
# Debug monitors from the CPU-stats phase: nothing in this UI ever
# creates a perf/sysmon widget (the CPU figures came from the IDF
# task stats), so the monitor code is pure flash weight. Snapshot is
# on: the concentric screen-switch reveal renders the new screen into
# a full-screen draw_buf before the center-out panel write.
CONFIG_LV_USE_SYSMON=n
CONFIG_LV_USE_PERF_MONITOR=n
CONFIG_LV_CONF_MINIMAL=y
CONFIG_LV_ASSERT_HANDLER_INCLUDE="assert.h"
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
